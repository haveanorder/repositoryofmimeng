@@ -0,0 +1,72 @@
+"use strict";
+const { nativeDriver } = require('./nativeSessionManager.cjs');
+const { launchPiFamily, handleAgentFrame } = require('./piRpcDriver.cjs');
+
+const implementation = {
+  launch: (session) => launchPiFamily(session, 'omp'),
+  async open(session) {
+    await session.rpc.waitReady();
+    await session.rpc.request('negotiate_protocol', { protocolVersion: 2 });
+    await session.rpc.request('set_ask_dialog', { enabled: true });
+    await session.rpc.request('set_subagent_subscription', { level: 'progress' });
+    // Native OMP host tools forward to the same scoped Netcatty MCP process.
+    const { Client } = require('@modelcontextprotocol/sdk/client/index.js');
+    const { StdioClientTransport } = require('@modelcontextprotocol/sdk/client/stdio.js');
+    const { ToolListChangedNotificationSchema } = require('@modelcontextprotocol/sdk/types.js');
+    session.mcpCalls = new Map();
+    session.hostTools = new Map();
+    const refresh = () => session.rpc.request('set_host_tools', { tools: [...session.hostTools.values()].map((entry) => entry.definition) });
+    for (const server of session.ctx.injectedMcpServers || []) {
+      const client = new Client({ name: 'netcatty-omp-host', version: '1.0.0' });
+      const transport = new StdioClientTransport({ command: server.command, args: server.args, env: { ...session.ctx.env, ...Object.fromEntries(server.env.map(({ name, value }) => [name, value])) }, stderr: 'pipe' });
+      await client.connect(transport);
+      transport.stderr?.resume();
+      session.disposers.push(() => client.close());
+      const update = async () => {
+        const listed = await client.listTools();
+        for (const [name, entry] of session.hostTools) if (entry.client === client) session.hostTools.delete(name);
+        for (const tool of listed.tools) {
+          const name = `netcatty__${tool.name}`;
+          session.hostTools.set(name, { client, toolName: tool.name, definition: {
+            name, description: tool.description || tool.name, parameters: tool.inputSchema, loadMode: 'essential',
+          } });
+        }
+        await refresh();
+      };
+      client.setNotificationHandler(ToolListChangedNotificationSchema, () => update().catch((error) => session.emit('warning', 'mcp-tools', error.message)));
+      await update();
+    }
+    const state = await session.rpc.request('get_state');
+    session.setNativeId(state.sessionFile || state.sessionId);
+  },
+  frame(session, frame) {
+    handleAgentFrame(session, frame);
+    if (frame.type === 'host_tool_call') {
+      const host = session.hostTools.get(frame.toolName);
+      const abort = new AbortController();
+      session.mcpCalls.set(frame.id, abort);
+      void host.client.callTool({ name: host.toolName, arguments: frame.arguments }, undefined, { signal: abort.signal }).then(
+        (result) => { if (!session.closing) session.rpc.send({ type: 'host_tool_result', id: frame.id, result, isError: result.isError }); },
+        (error) => { if (!session.closing) session.rpc.send({ type: 'host_tool_result', id: frame.id, isError: true, result: { content: [{ type: 'text', text: error.message }] } }); },
+      ).finally(() => session.mcpCalls.delete(frame.id));
+    }
+    if (frame.type === 'host_tool_cancel') session.mcpCalls.get(frame.targetId)?.abort();
+    if (frame.type === 'subagent_lifecycle' || frame.type === 'subagent_progress') {
+      const task = frame.payload;
+      const id = task.id || [...session.tasks.values()].find((entry) => entry.index === task.index)?.id;
+      if (id) session.tasks.set(id, { ...session.tasks.get(id), ...task, name: task.agent, id, kind: 'subagent' });
+      session.publish();
+    }
+    if (frame.type === 'prompt_result') {
+      if (frame.status === 'error') session.turnError = new Error(frame.error?.message || 'OMP prompt failed');
+      if (frame.agentInvoked === false) { session.finish(session.turnError); session.turnError = null; }
+    }
+    if (frame.type === 'session_settled') { session.finish(session.turnError); session.turnError = null; }
+    if (frame.type === 'rpc_frame_error' || frame.type === 'fatal') session.finish(new Error(frame.error || 'OMP frame overflow'));
+  },
+  async prompt(session, message) {
+    const result = await session.rpc.request('prompt', { message });
+    if (result?.agentInvoked === false) session.finish();
+  },
+};
+module.exports = nativeDriver('omp', implementation);
