diff --git a/packages/netcatty-dsh-bridge/bridge.mjs b/packages/netcatty-dsh-bridge/bridge.mjs
new file mode 100644
index 0000000..3eadbaf
--- /dev/null
+++ b/packages/netcatty-dsh-bridge/bridge.mjs
@@ -0,0 +1,179 @@
+import process from 'node:process';
+import { setImmediate } from 'node:timers';
+// DSH 0.2.1-alpha.1 profile plugin. The CLI owns boot, persistence and agent loop.
+import { createRequire } from 'node:module';
+import { realpathSync } from 'node:fs';
+import { pathToFileURL } from 'node:url';
+import { createInterface } from 'node:readline';
+import { randomUUID } from 'node:crypto';
+
+export const name = 'netcatty-native-bridge';
+export const inject = ['agents', 'tools', 'jobs', 'approval', 'userQuestions', 'planMode'];
+
+export async function apply(ctx) {
+  const requireEngine = createRequire(realpathSync(process.env.NETCATTY_DSH_ENTRY));
+  const { createUserMessage } = await import(pathToFileURL(requireEngine.resolve('@deepseek-ai/dsh-llm')));
+  const { UserQuestionError } = await import(pathToFileURL(requireEngine.resolve('@deepseek-ai/dsh-user-questions')));
+  const send = (frame) => process.stdout.write(`${JSON.stringify(frame)}\n`);
+  const pending = new Map();
+  let handle;
+  let stopping = false;
+  let settling;
+  let activeTurnId;
+  const continuedQuestions = new Set();
+  const publishContinuedQuestions = () => {
+    if (!handle || stopping) return;
+    const projection = ctx.get('sessionProjections')?.stateOf(handle.agent.session, 'userQuestions');
+    for (const question of projection?.questions.active || []) {
+      if (question.state !== 'continued' || continuedQuestions.has(question.callId)) continue;
+      continuedQuestions.add(question.callId);
+      send({ type: 'interaction', id: `continued:${question.callId}`, kind: 'questions', questions: question.questions });
+    }
+  };
+  const owned = (agent) => agent && (agent === handle?.agent || ctx.agents.list().includes(agent));
+  const ask = (payload, signal) => new Promise((resolve) => {
+    const id = randomUUID();
+    const finish = (value) => {
+      if (!pending.delete(id)) return;
+      signal?.removeEventListener('abort', cancel);
+      send({ type: 'interaction-cleared', id });
+      resolve(value);
+    };
+    const cancel = () => finish({ cancelled: true });
+    pending.set(id, finish);
+    signal?.addEventListener('abort', cancel, { once: true });
+    send({ type: 'interaction', id, ...payload });
+    if (signal?.aborted) cancel();
+  });
+
+  ctx.on('approval/request', async (request) => {
+    const answer = await ask({ kind: 'approval', toolName: request.toolName, reason: request.reason }, request.signal);
+    return answer.cancelled ? 'cancelled' : answer.approved ? 'allowed-once' : 'rejected';
+  });
+  ctx.on('user-questions/request', async (request) => {
+    const answer = await ask({ kind: 'questions', questions: request.questions }, request.signal);
+    if (request.signal?.aborted) throw request.signal.reason;
+    if (answer.cancelled) throw new UserQuestionError('Question dismissed', 'ASK_CANCELLED');
+    return { answers: answer.answers || [] };
+  });
+  // Remote MCP always uses Netcatty's own policy. Local approval is independent.
+  ctx.on('tools/pre-execute', async (exec, next) => {
+    if (exec.name.startsWith('mcp__netcatty__')) return next();
+    const interactionTools = ['ask_user_question', 'exit_plan_mode', 'todo_write', 'job_list', 'job_output', 'job_kill'];
+    if (interactionTools.includes(exec.name)) return next();
+    if (process.env.NETCATTY_NATIVE_LOCAL_TOOLS !== 'confirm') {
+      return { kind: 'deny', reason: 'Local workspace tools are disabled in Netcatty settings. Use Netcatty MCP for connected terminals.' };
+    }
+    if (process.env.NETCATTY_NATIVE_PERMISSION === 'observer') return { kind: 'deny', reason: 'Observer mode blocks local tools.' };
+    const answer = await ask({ kind: 'approval', toolName: exec.name, args: exec.arguments }, exec.signal);
+    if (answer.cancelled) return { kind: 'cancel' };
+    return answer.approved ? next() : { kind: 'deny', reason: 'Local tool denied by user.' };
+  });
+  ctx.on('agent/assistant-stream', ({ agent, frame }) => {
+    if (agent === handle?.agent) send({ type: 'assistant-stream', frame });
+  });
+  ctx.on('session/event', (session, event) => {
+    if (session.id === handle?.agent.session.id) {
+      send({ type: 'session-event', event });
+      // PlanMode clears its pending intent after appending this event.
+      if (event.type === 'plan/mode') void Promise.resolve().then(() => send({ type: 'plan-state', plan: ctx.planMode.get(handle.agent) }));
+      void Promise.resolve().then(publishContinuedQuestions);
+    }
+  });
+  ctx.on('agent/status', ({ agent, status }) => {
+    if (owned(agent)) send({ type: 'agent-status', id: String(agent.id), primary: agent === handle?.agent, status });
+  });
+  ctx.effect(() => ctx.jobs.attachController('netcatty'), 'netcatty.jobs');
+  ctx.effect(() => ctx.jobs.events.subscribe({ owners: 'all' }, (event) => send({ type: 'job-event', event })), 'netcatty.job-events');
+
+  const stop = async () => {
+    stopping = true;
+    for (const finish of [...pending.values()]) finish({ cancelled: true });
+    for (const agent of ctx.agents.list()) {
+      agent.cancel({ kind: 'user' }); // Intentionally clears inbox (no keepInbox).
+      for (const job of ctx.jobs.list(agent.session.id)) ctx.jobs.kill(job.id, agent.session.id, 'Netcatty stop');
+    }
+    await Promise.all(ctx.agents.list().map((agent) => agent.whenIdle()));
+  };
+  const waitUntilSettled = async () => {
+    // whenIdle covers queues; Jobs are a separate service and can wake agents.
+    for (;;) {
+      await Promise.all(ctx.agents.list().map((agent) => agent.whenIdle()));
+      const liveJobs = ctx.agents.list().flatMap((agent) => ctx.jobs.list(agent.session.id))
+        .filter((job) => job.status === 'running' || job.status === 'stopping');
+      if (!liveJobs.length) break;
+      await new Promise((resolve) => {
+        const off = ctx.jobs.events.subscribe({ owners: 'all' }, (event) => {
+          if (event.type === 'settled') { off(); resolve(); }
+        });
+      });
+    }
+    send({ type: 'turn-settled', turnId: activeTurnId, cancelled: stopping });
+    activeTurnId = undefined;
+  };
+  const settle = () => {
+    settling ||= waitUntilSettled().catch((error) => send({ type: 'fatal', error: error.message })).finally(() => { settling = undefined; });
+    return settling;
+  };
+  const dispatch = async (command) => {
+    switch (command.type) {
+      case 'initialize': {
+        await ctx.get('loader')?.await();
+        const options = { ...(command.provider ? { provider: command.provider } : {}), ...(command.model ? { model: command.model } : {}) }; 
+        handle = command.resumeSessionId
+          ? await ctx.agents.resume({ resumeSessionId: command.resumeSessionId, agentOptions: options })
+          : await ctx.agents.create({ sessionId: `netcatty-${randomUUID()}`, meta: { cwd: command.cwd }, agentOptions: options });
+        publishContinuedQuestions();
+        return { sessionId: String(handle.agent.session.id), version: process.env.NETCATTY_NATIVE_VERSION, bridgeVersion: 1 };
+      }
+      case 'prompt': {
+        stopping = false;
+        activeTurnId = command.turnId;
+        const message = createUserMessage({ content: [{ type: 'text', text: command.message }], source: { kind: 'user' } });
+        handle.agent.followup(message);
+        void settle();
+        return { messageId: message.id };
+      }
+      case 'abort': await stop(); return {};
+      case 'snapshot': return { jobs: ctx.jobs.list(handle.agent.session.id), status: handle.agent.status, plan: ctx.planMode.get(handle.agent) };
+      case 'plan_mode': {
+        const result = ctx.planMode.set(handle.agent, command.active);
+        send({ type: 'plan-state', plan: ctx.planMode.get(handle.agent) });
+        return { result };
+      }
+      case 'job_kill': return { result: ctx.jobs.kill(command.jobId, handle.agent.session.id, 'Netcatty task stop') };
+      case 'job_read': return ctx.jobs.readAt(command.jobId, 0, handle.agent.session.id);
+      case 'shutdown':
+        await stop();
+        await handle?.dispose();
+        setImmediate(() => { void ctx.root.fiber.dispose().then(() => process.exit(0)); });
+        return {};
+      default: throw new Error(`Unsupported Netcatty bridge command: ${command.type}`);
+    }
+  };
+  const input = createInterface({ input: process.stdin, crlfDelay: Infinity });
+  input.on('line', (line) => {
+    let command;
+    try { command = JSON.parse(line); } catch (error) { send({ type: 'fatal', error: error.message }); return; }
+    if (command.type === 'interaction_response') {
+      if (command.id.startsWith('continued:')) {
+        const callId = command.id.slice('continued:'.length);
+        if (!command.cancelled && continuedQuestions.has(callId)) {
+          try {
+            ctx.userQuestions.answer(handle.agent, callId, { answers: command.answers || [] });
+            continuedQuestions.delete(callId);
+            void settle();
+          } catch (error) { send({ type: 'notice', message: error.message }); return; }
+        }
+        send({ type: 'interaction-cleared', id: command.id });
+      } else pending.get(command.id)?.(command);
+      return;
+    }
+    void dispatch(command).then(
+      (data) => send({ type: 'response', id: command.id, success: true, data }),
+      (error) => send({ type: 'response', id: command.id, success: false, error: error.message }),
+    );
+  });
+  ctx.effect(() => () => input.close(), 'netcatty.input');
+  send({ type: 'ready', version: process.env.NETCATTY_NATIVE_VERSION, bridgeVersion: 1 });
+}
