@@ -0,0 +1,38 @@
+export const NATIVE_AGENTS = {
+  omp: { name: 'Oh My Pi', version: '18.5.1', install: 'Official OMP v18.5.1 standalone release (github.com/can1357/oh-my-pi/releases)' },
+  pi: { name: 'Pi', version: '1.0.3', install: 'npm install -g @earendil-works/pi-coding-agent@1.0.3' },
+  dsh: { name: 'DeepSeek Harness', version: '0.2.0-rc.2', install: 'npm install -g @deepseek-ai/dsh@0.2.0-rc.2' },
+} as const;
+export type NativeEngine = keyof typeof NATIVE_AGENTS;
+export interface NativeQuestion {
+  id: string; question: string; detail?: string; header?: string;
+  options?: Array<{ label: string; description?: string }>;
+  multi?: boolean; multiSelect?: boolean; intent?: { kind: string; approve?: string };
+}
+export interface NativeInteraction {
+  id: string; method: string; title?: string; message?: string; prefill?: string;
+  options?: string[]; questions?: NativeQuestion[];
+}
+export interface NativeSessionSnapshot {
+  chatSessionId: string; instanceId: string; seq: number; engine: NativeEngine; version: string; status: string;
+  plan?: { active: boolean; pending?: boolean };
+  interactions: NativeInteraction[];
+  tasks: Array<{ id: string; kind: string; name?: string; title?: string; status?: string; progress?: unknown }>;
+  widgets: Array<{ id: string; text: string }>;
+}
+export interface NativeControl {
+  chatSessionId: string; instanceId?: string; action: string; id?: string; message?: string; answer?: Record<string, unknown>;
+}
+export interface NativeControlResult { ok: boolean; error?: string; snapshot?: NativeSessionSnapshot | null; data?: unknown }
+
+/** Readable output from the pinned OMP transcript and DSH job APIs. */
+export function nativeTaskOutput(data: unknown): string {
+  if (!data || typeof data !== 'object') return String(data ?? '');
+  const value = data as { chunks?: Array<{ text: string }>; messages?: Array<{ role?: string; content?: string | Array<{ text?: string }> }> };
+  if (value.chunks) return value.chunks.map((chunk) => chunk.text).join('');
+  if (value.messages) return value.messages.map((message) => {
+    const content = typeof message.content === 'string' ? message.content : message.content?.map((part) => part.text || '').join('\n');
+    return `${message.role || ''}\n${content || ''}`.trim();
+  }).join('\n\n');
+  return JSON.stringify(data, null, 2);
+}
