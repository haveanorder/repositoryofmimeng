diff --git a/electron/bridges/aiBridge/sdk/nativeCli.cjs b/electron/bridges/aiBridge/sdk/nativeCli.cjs
new file mode 100644
index 0000000..6c92e9b
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/nativeCli.cjs
@@ -0,0 +1,32 @@
+"use strict";
+const path = require('node:path');
+const fs = require('node:fs');
+const { prepareCommandForSpawn, resolveCliFromPath } = require('../../ai/shellUtils.cjs');
+
+// Resolve npm and Pi installer shims without changing the installed CLI.
+function nativeEntry(command, engine) {
+  if (!/\.(cmd|bat)$/i.test(command) || engine === 'omp') return fs.realpathSync(command);
+  const shim = fs.readFileSync(command, 'utf8');
+  const script = shim.match(/"%~dp0([^"\r\n]+\.[cm]?js)"/i) || shim.match(/"%dp0%([^"\r\n]+\.[cm]?js)"/i);
+  if (script) {
+    const entry = path.resolve(path.dirname(command), script[1].replace(/[\\/]/g, path.sep));
+    if (fs.existsSync(entry)) return fs.realpathSync(entry);
+  }
+  const packageName = engine === 'dsh' ? '@deepseek-ai/dsh' : '@earendil-works/pi-coding-agent';
+  const shimDirectory = path.dirname(path.resolve(command));
+  // npm places local shims in node_modules/.bin and global Windows shims next
+  // to node_modules. Read the manifest directly: Pi does not export it.
+  const modules = path.basename(shimDirectory) === '.bin' ? path.dirname(shimDirectory) : path.join(shimDirectory, 'node_modules');
+  const manifest = path.join(modules, packageName, 'package.json');
+  if (!fs.existsSync(manifest)) return fs.realpathSync(command);
+  const pkg = JSON.parse(fs.readFileSync(manifest, 'utf8'));
+  return path.resolve(path.dirname(manifest), pkg.bin[engine]);
+}
+function prepareNativeCommand(command, args, env) {
+  if (/\.[cm]?js$/i.test(command)) {
+    const adjacentNode = path.join(path.dirname(command), process.platform === 'win32' ? 'node.exe' : 'node');
+    return { command: fs.existsSync(adjacentNode) ? adjacentNode : resolveCliFromPath('node', env) || 'node', args: [command, ...args], shell: false };
+  }
+  return prepareCommandForSpawn(command, args, { unwrapNativeExe: false });
+}
+module.exports = { nativeEntry, prepareNativeCommand };
