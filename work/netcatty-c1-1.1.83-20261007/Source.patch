+function versionOf(command, env) {
+  const spec = prepareNativeCommand(command, ['--version'], env);
+  return new Promise((resolve, reject) => execFile(spec.command, spec.args, {
+    env, shell: spec.shell, windowsHide: true, timeout: 15000,
+  }, (error, stdout) => error ? reject(error) : resolve(stdout.trim())));
+}
+function resourcePath(...parts) {
+  return path.join(__dirname.replace(/app\.asar([/\\])/, 'app.asar.unpacked$1'), ...parts);
+}
+function decodeResume(value, engine, ctx) {
+  if (!value) return undefined;
+  const identity = JSON.parse(value);
+  if (identity.v !== 1 || identity.engine !== engine || identity.cwd !== path.resolve(ctx.cwd)) {
+    throw new Error('Native session runtime or workspace changed. Start a new chat to use this configuration.');
+  }
+  return identity.id;
+}
+
+class NativeSession {
+  constructor(engine, implementation, ctx) {
+    this.engine = engine;
+    this.implementation = implementation;
+    this.ctx = ctx;
+    this.key = fingerprint(ctx);
+    this.instanceId = randomUUID();
+    this.interactions = new Map();
+    this.tasks = new Map();
+    this.widgets = new Map();
+    this.status = 'starting';
+    this.seq = 0;
+    this.disposers = [];
+    if (ctx.sender?.once) {
+      const destroyed = () => { void this.stop(); };
+      ctx.sender.once('destroyed', destroyed);
+      this.disposers.push(() => ctx.sender.removeListener('destroyed', destroyed));
+    }
+  }
+  publish() {
+    this.ctx.emitNativeSession?.(this.snapshot());
+  }
+  snapshot() {
+    return {
+      chatSessionId: this.ctx.chatSessionId, engine: this.engine, instanceId: this.instanceId,
+      seq: ++this.seq, version: this.version, status: this.status,
+      plan: this.plan,
+      interactions: [...this.interactions.values()], tasks: [...this.tasks.values()], widgets: [...this.widgets.values()],
+    };
+  }
+  emit(method, ...args) {
+    if (this.turn) this.turn.emitter[method]?.(...args);
+    else if (method === 'text') {
+      const previous = this.widgets.get('continuation')?.text || '';
+      this.widgets.set('continuation', { id: 'continuation', text: previous + args[0] });
+      this.publish();
+    }
+  }
+  setNativeId(id) {
+    this.nativeId = id;
+    this.identity = JSON.stringify({ v: 1, engine: this.engine, version: this.version, cwd: path.resolve(this.ctx.cwd), id });
+    this.emit('sessionId', this.identity);
+  }
+  async start() {
+    this.entry = nativeEntry(this.ctx.binPath, this.engine);
+    const actualVersion = await versionOf(this.entry, this.ctx.env);
+    this.version = actualVersion.match(/\d+\.\d+\.\d+(?:-[\w.-]+)?/)?.[0] || actualVersion;
+    this.resume = decodeResume(this.ctx.resumeSessionId, this.engine, this.ctx);
+    if (this.ctx.signal?.aborted || this.closing) throw new Error("Native startup cancelled");
+    const spec = await this.implementation.launch(this);
+    spec.env.NETCATTY_NATIVE_VERSION = this.version;
+    spec.args.push(...JSON.parse(this.ctx.env.NETCATTY_NATIVE_ARGS || '[]')); 
+    if (this.ctx.signal?.aborted || this.closing) throw new Error("Native startup cancelled");
+    this.rpc = new NativeRpcConnection({ command: this.entry, ...spec, engine: this.engine, cwd: this.ctx.cwd });
+    this.rpc.on('fatal', (error) => {
+      if (this.closing) return;
+      this.status = 'error'; this.widgets.set('error', { id: 'error', text: error.message }); this.publish();
+      this.finish(error);
+      void this.close();
+    });
+    this.rpc.on('frame', (frame) => {
+      try {
+        if (frame.type === 'extension_ui_request' || frame.type === 'interaction') {
+          void this.handleUi(frame).catch((error) => { this.finish(error); void this.close(); }); return;
+        }
+        if (frame.type === 'interaction-cleared') { this.interactions.delete(frame.id); this.publish(); return; }
+        this.implementation.frame(this, frame);
+      } catch (error) { this.finish(error); }
+    });
+    await this.implementation.open(this);
+    this.status = 'idle'; this.publish();
+  }
+  async handleUi(frame) {
+    const method = frame.method || frame.kind;
+    if (method === 'cancel') { this.interactions.delete(frame.targetId); this.publish(); return; }
+    if (['notify', 'setStatus', 'setWidget', 'setTitle', 'set_editor_text'].includes(method)) {
+      const id = frame.widgetKey || frame.statusKey || method;
+      const text = frame.widgetLines?.join('\n') || frame.statusText || frame.message || frame.title || frame.text || '';
+      if (text) this.widgets.set(id, { id, text }); else this.widgets.delete(id);
+      this.publish(); return;
+    }
+    if (method === 'approval' || (method === 'confirm' && frame.title === 'Netcatty local tool')) {
+      const ctx = this.ctx;
+      const approved = ctx.permissionMode !== 'observer' && await ctx.requestApprovalFromRenderer?.(
+        `${this.engine.toUpperCase()} local workspace: ${frame.toolName || 'tool'}`,
+        { cwd: ctx.cwd, ...frame.args, details: frame.reason || frame.message, executionScope: 'local-workspace' }, ctx.chatSessionId, { allowSession: false },
+      );
+      if (!this.closing && !ctx.signal?.aborted) {
+        this.rpc.send(this.engine === 'dsh'
+          ? { type: 'interaction_response', id: frame.id, approved: Boolean(approved) }
+          : { type: 'extension_ui_response', id: frame.id, confirmed: Boolean(approved) });
+      }
+      return;
+    }
+    this.interactions.set(frame.id, { ...frame, method });
+    this.publish();
+    if (frame.timeout) {
+      const timer = setTimeout(() => { this.interactions.delete(frame.id); this.publish(); }, frame.timeout);
+      this.disposers.push(() => clearTimeout(timer));
+    }
+  }
+  respond(id, answer) {
+    if (!this.interactions.has(id)) return false;
+    this.interactions.delete(id);
+    this.rpc.send({ ...answer, id, type: this.engine === 'dsh' ? 'interaction_response' : 'extension_ui_response' });
+    this.publish(); return true;
+  }
+  finish(error) {
+    if (!this.turn || (this.closing && this.status !== 'closed')) return;
+    const turn = this.turn; this.turn = null;
+    this.status = this.closing ? 'closed' : error ? 'error' : 'idle'; this.publish();
+    if (error) turn.reject(error);
+    else { turn.emitter.emitDone(); turn.resolve({ sessionId: this.identity }); }
+  }
+  async run(ctx) {
+    if (this.turn) throw new Error('A native turn is already running in this chat');
+    this.ctx = ctx;
+    this.status = 'running';
+    const result = new Promise((resolve, reject) => { this.turn = { id: randomUUID(), resolve, reject, emitter: ctx.emitter }; });
+    void result.catch(() => {}); // Startup failures may arrive before prompt admission returns.
+    const abort = () => { void this.stop(); };
+    ctx.signal?.addEventListener('abort', abort, { once: true });
+    try {
+      if (!this.rpc) await this.start();
+      if (ctx.signal?.aborted) { await this.stop(); return await result; }
+      this.emit('sessionId', this.identity);
+      this.status = 'running'; this.publish();
+      await this.implementation.prompt(this, ctx.prompt);
+    } catch (error) { this.finish(error); await this.close(); }
+    return result.finally(() => ctx.signal?.removeEventListener('abort', abort));
+  }
+  async stop() {
+    this.ctx.clearPendingApprovals?.(this.ctx.chatSessionId);
+    await this.close();
+    this.finish();
+  }
+  async close() {
+    if (this.closing) return this.closing;
+    this.closing = (async () => {
+      this.interactions.clear();
+      await this.rpc?.close();
+      for (const dispose of this.disposers.splice(0)) await dispose();
+      this.status = 'closed'; this.publish();
+      if (sessions.get(this.ctx.chatSessionId) === this) sessions.delete(this.ctx.chatSessionId);
+    })();
+    return this.closing;
+  }
+}
+
+function nativeDriver(engine, implementation) {
+  return {
+    async runTurn(ctx) {
+      if (ctx.attachments?.length) throw new Error('Native scheme C currently accepts text prompts. Use a file path or Netcatty MCP to read an attachment.');
+      if (ctx.toolIntegrationMode !== 'mcp') throw new Error('Native agents require MCP tool integration in Settings > AI > Tools.');
+      let session = sessions.get(ctx.chatSessionId);
+      if (session && (session.engine !== engine || session.key !== fingerprint(ctx))) { await session.close(); session = null; }
+      if (!session) { session = new NativeSession(engine, implementation, ctx); sessions.set(ctx.chatSessionId, session); }
+      return session.run(ctx);
+    },
+    async listModels() { return []; },
+  };
+}
+const nativeSessionManager = {
+  get(chatSessionId, sender) {
+    const session = sessions.get(chatSessionId);
+    return session && (!sender || session.ctx.sender === sender) ? session : undefined;
+  },
+  async closeForChat(chatSessionId) { await sessions.get(chatSessionId)?.stop(); },
+  async closeAll() { await Promise.all([...sessions.values()].map((session) => session.stop())); },
+};
+async function writeSessionFile(session, name, content) {
+  const dir = path.join(session.ctx.getTempDir(), `native-${session.instanceId}`);
+  await fs.mkdir(dir, { recursive: true, mode: 0o700 });
+  const file = path.join(dir, name);
+  await fs.writeFile(file, content, { mode: 0o600 });
+  session.disposers.push(() => fs.rm(file, { force: true }));
+  return file;
+}
+module.exports = { nativeDriver, nativeSessionManager, resourcePath, writeSessionFile, VERSIONS };
