+++ b/scripts/windows-cross.config.cjs
@@ -0,0 +1,40 @@
+"use strict";
+// Use only in a staging copy with the Windows native payloads prepared as
+// described in docs/native-agents-c.md. Normal Windows builds use the main config.
+const fs = require('node:fs');
+const path = require('node:path');
+const config = require('../electron-builder.config.cjs');
+const { readPeMachine } = require('./build-windows-hello-helper.cjs');
+const { WineVmManager } = require('app-builder-lib/out/vm/WineVm.js');
+const { UninstallerReader } = require('app-builder-lib/out/targets/nsis/nsisUtil.js');
+
+// electron-builder 26.15.2 already uses this reader on macOS. This cloud's
+// Wine setup cannot run the NSIS bootstrap; use the same official reader to
+// extract the NSIS-generated uninstaller, without changing its installer script.
+WineVmManager.prototype.exec = (installer) => UninstallerReader.exec(
+  installer, path.join(path.dirname(installer), path.basename(installer, 'exe') + '__uninstaller.exe'),
+);
+const project = path.resolve(__dirname, '..');
+const payloads = [
+  'electron/bridges/windowsHelloHelper/build/x64/NetcattyWindowsHello.exe',
+  'node_modules/node-pty/prebuilds/win32-x64/conpty.node',
+  'node_modules/node-pty/prebuilds/win32-x64/conpty_console_list.node',
+  'node_modules/sqlite3/build/Release/node_sqlite3.node',
+  'node_modules/@vscode/windows-process-tree/build/Release/windows_process_tree.node',
+  'node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/@serialport+bindings-cpp.node',
+];
+config.npmRebuild = false;
+config.beforePack = () => {
+  for (const file of payloads) if (readPeMachine(path.join(project, file)) !== 0x8664) throw new Error('Expected Windows x64 payload: ' + file);
+};
+config.afterPack = ({ appOutDir }) => {
+  const relative = 'node_modules/node-pty/prebuilds/win32-x64/conpty.node';
+  const packaged = path.join(appOutDir, 'resources/app.asar.unpacked', relative);
+  if (!fs.readFileSync(packaged).equals(fs.readFileSync(path.join(project, relative)))) throw new Error('Patched ConPTY payload changed');
+};
+config.extraMetadata = { version: '0.0.0-c1.20261005' };
+config.productName = 'Netcatty C1';
+config.appId = 'com.netcatty.native-c1';
+config.nsis.shortcutName = 'Netcatty C1';
+config.publish = null;
+module.exports = config;
