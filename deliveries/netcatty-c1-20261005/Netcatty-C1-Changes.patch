+import { NATIVE_AGENTS, type NativeEngine } from '../../../../infrastructure/ai/nativeAgents';
+
+export function NativeAgentCard({ engine, config, onSave }: { engine: NativeEngine; config?: ExternalAgentConfig; onSave: (config: ExternalAgentConfig) => void }) {
+  const { t } = useI18n();
+  const state = useNativeAgentSettings(engine, config, onSave);
+  const inputClass = 'w-full rounded-md border border-input bg-background px-3 py-2 text-xs';
