+"use strict";
+const { nativeDriver, resourcePath } = require('./nativeSessionManager.cjs');
+const { randomUUID } = require('node:crypto');
+
+function launchPiFamily(session, engine) {
+  const { ctx } = session;
+  const args = ['--mode', engine === 'omp' ? 'rpc-ui' : 'rpc', '--no-extensions', '--extension', resourcePath('nativeExtensions', 'controlled.mjs')];
+  // Pi implements MCP as a built-in extension; discovery remains disabled.
+  if (engine === 'pi') args.push('--extension', 'builtin:mcp');
+  if (ctx.model) args.push('--model', ctx.model);
+  if (session.resume) args.push('--session', session.resume);
+  for (const extension of JSON.parse(ctx.env.NETCATTY_NATIVE_EXTENSIONS || '[]')) args.push('--extension', extension);
+  const mcpServers = (ctx.injectedMcpServers || []).map((server) => ({ ...server, name: `netcatty_${randomUUID().slice(0, 8)}` }));
+  return { args, env: { ...ctx.env, NETCATTY_NATIVE_CONFIG: JSON.stringify({
+    engine, mcpServers, localTools: ctx.env.NETCATTY_NATIVE_LOCAL_TOOLS || 'disabled', permissionMode: ctx.permissionMode,
+  }) } };
+}
+function handleAgentFrame(session, frame) {
+  const message = frame.assistantMessageEvent;
+  if (frame.type === 'message_update' && message) {
+    if (message.type === 'text_delta') session.emit('text', message.delta);
+    if (message.type === 'thinking_delta') session.emit('reasoning', message.delta);
+    if (message.type === 'thinking_end') session.emit('reasoningEnd');
+  }
+  if (frame.type === 'tool_execution_start') session.emit('toolCall', frame.toolName, frame.args, frame.toolCallId);
+  if (frame.type === 'tool_execution_end') session.emit('toolResult', frame.toolCallId, frame.result, frame.toolName);
+  if (frame.type === 'message_end' && frame.message?.role === 'assistant') {
+    const { usage, stopReason, errorMessage } = frame.message;
+    if (usage) session.emit('usage', { inputTokens: usage.input, outputTokens: usage.output, cachedInputTokens: usage.cacheRead, totalTokens: usage.totalTokens });
+    if (stopReason === 'error') session.turnError = new Error(errorMessage || 'Native model request failed');
+  }
+  if (frame.type === 'extension_error') session.emit('warning', 'extension', frame.error);
+}
+const implementation = {
+  launch: (session) => launchPiFamily(session, 'pi'),
+  async open(session) {
+    const state = await session.rpc.request('get_state');
+    session.setNativeId(state.sessionFile || state.sessionId);
+  },
+  frame(session, frame) {
+    handleAgentFrame(session, frame);
+    if (frame.type === 'agent_settled') { session.finish(session.turnError); session.turnError = null; }
+  },
+  async prompt(session, message) {
+    const result = await session.rpc.request('prompt', { message });
+    if (result?.disposition === 'handled') session.finish();
+  },
+};
+module.exports = { ...nativeDriver('pi', implementation), launchPiFamily, handleAgentFrame };
