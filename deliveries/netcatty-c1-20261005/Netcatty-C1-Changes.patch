index 00000000..30d9beea
--- /dev/null
+++ b/scripts/native-agents.electron.live.cjs
@@ -0,0 +1,102 @@
+"use strict";
+// Run against an isolated Netcatty Electron profile with --remote-debugging-port=9222.
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const { createNativeModelService } = require('./native-model-service.cjs');
+
+async function connect(pagePattern) {
+  const pages = await (await fetch(`http://127.0.0.1:${process.env.NATIVE_ELECTRON_PORT || 9222}/json/list`)).json();
+  const page = pages.find((entry) => entry.type === 'page' && !entry.url.startsWith('devtools:') && (pagePattern ? entry.url.includes(pagePattern) : !entry.url.includes('#/settings')));
+  assert(page, 'Netcatty Electron window must be running');
+  const ws = new WebSocket(page.webSocketDebuggerUrl);
+  await new Promise((resolve) => ws.addEventListener('open', resolve, { once: true }));
+  const pending = new Map(); let id = 0;
+  ws.addEventListener('message', ({ data }) => {
+    const message = JSON.parse(data); const p = pending.get(message.id);
+    if (!p) return;
+    pending.delete(message.id);
+    if (message.error || message.result.exceptionDetails) p.reject(new Error(JSON.stringify(message.error || message.result.exceptionDetails)));
+    else p.resolve(message.result);
+  });
+  const request = (method, params) => new Promise((resolve, reject) => {
+      pending.set(++id, { resolve, reject });
+      ws.send(JSON.stringify({ id, method, params }));
+    });
+  return { request, evaluate: async (expression) => (await request('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true })).result?.value, close: () => ws.close() };
+}
+async function main() {
+  const root = process.env.NETCATTY_NATIVE_RUNTIME;
+  assert(root, 'Set NETCATTY_NATIVE_RUNTIME');
+  const service = await createNativeModelService();
+  const cdp = await connect();
+  const scratch = await fs.mkdtemp(path.join(root, 'electron-smoke-'));
+  try {
+    console.log(await cdp.evaluate(`(async () => {
+      const api = window.netcatty;
+      for (const sessionId of ['native-smoke-a', 'native-smoke-b']) await api.startLocalSession({ sessionId, shell: '/bin/bash', cwd: '/workspace/Netcatty', cols: 100, rows: 30 });
+      await api.aiMcpSetPermissionMode('confirm');
+      await api.aiMcpUpdateLiveSessions(['a','b'].map(x => ({ sessionId: 'native-smoke-' + x, hostname: 'local-' + x, label: 'Native smoke ' + x, protocol: 'local', shellType: 'bash', connected: true })));
+      return { title: document.title, localPty: true };
+    })()`));
+    for (const engine of (process.env.NATIVE_ENGINES || 'dsh,pi,omp').split(',')) {
+      const dir = path.join(scratch, engine); await fs.mkdir(dir);
+      const models = { providers: { local: { api: 'openai-completions', baseUrl: `${service.url}/v1`, apiKey: 'local-test-key', models: [{ id: 'netcatty-smoke', reasoning: false, input: ['text'], contextWindow: 64000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }] } } };
+      await fs.writeFile(path.join(dir, 'models.json'), JSON.stringify(models));
+      await fs.writeFile(path.join(dir, 'models.yml'), JSON.stringify(models));
+      const config = { engine, cwd: scratch, bin: engine === 'omp' ? path.join(root, 'bin/omp') : path.join(root, 'runtime/node_modules/.bin', engine), model: engine === 'dsh' ? 'deepseek-official/deepseek-flash' : 'local/netcatty-smoke', env: { PI_CODING_AGENT_DIR: dir, DSH_HOME: path.join(dir, 'dsh'), DEEPSEEK_API_KEY: 'local-test-key', DEEPSEEK_BASE_URL: service.url, NETCATTY_NATIVE_LOCAL_TOOLS: 'disabled' } };
+      const result = await cdp.evaluate(`(async (config) => {
+        const api = window.netcatty; const chat = 'native-electron-' + config.engine;
+        const events = []; let allow = false; let approvals = 0;
+        let approvalSeen;
+        await api.aiMcpUpdateSessions([{sessionId:'native-smoke-a',hostname:'local-a',label:'Native smoke a',protocol:'local',shellType:'bash',connected:true}], chat);
+        const offApproval = api.onMcpApprovalRequest((request) => {
+          if (request.chatSessionId !== chat) return;
+          approvals++;
+          if (approvalSeen) approvalSeen(request);
+          else api.respondMcpApproval(request.approvalId, allow, 'once');
+        });
+        const run = async (prompt) => {
+          const requestId = crypto.randomUUID();
+          const off = api.onAiSdkAgentEvent(requestId, (event) => events.push(event));
+          const offError = api.onAiSdkAgentError(requestId, (error) => events.push({type:'fatal',error}));
+          try { const result = await api.aiSdkAgentStream(requestId, chat, config.engine, prompt, config.cwd, undefined, config.model, undefined, [], undefined, 'mcp', undefined, undefined, config.env, config.bin, undefined, 'confirm'); if (!result.ok) throw Error(JSON.stringify(result)); }
+          finally { off(); offError(); }
+        };
+        try {
+          await run('NC_REMOTE inspect the scoped connected terminals');
+          const environment = events.filter(event => event.type === 'tool-result');
+          if (!JSON.stringify(environment).includes('local-a') || JSON.stringify(environment).includes('local-b')) throw Error('MCP scope failed: ' + JSON.stringify(events));
+          await run('NC_EXEC denied terminal command');
+          const denied = events.filter(event => event.type === 'tool-result').at(-1);
+          if (JSON.stringify(denied).includes('NETCATTY_MCP_CLI_OK')) throw Error('Denied command executed');
+          allow = true;
+          await run('NC_EXEC approved terminal command');
+          const executed = events.filter(event => event.type === 'tool-result').at(-1);
+          if (!JSON.stringify(executed).includes('NETCATTY_MCP_CLI_OK')) throw Error('Terminal command did not execute: ' + JSON.stringify(executed));
+          if (approvals < 2) throw Error('Missing approvals');
+          const beforeStop = events.length;
+          const waiting = new Promise(resolve => { approvalSeen = resolve; });
+          const pendingTurn = run('NC_EXEC cancel while waiting for approval');
+          const pendingRequest = await waiting;
+          await api.aiSdkAgentCancel('', chat);
+          await api.respondMcpApproval(pendingRequest.approvalId, true, 'once');
+          await pendingTurn;
+          if (events.slice(beforeStop).some(event => event.type === 'tool-result' && JSON.stringify(event.output).includes('NETCATTY_MCP_CLI_OK'))) throw Error('Late approval executed after stop');
+          return { engine: config.engine, scopedMcp: true, approvalAndDenial: true, localPtyExecution: true, stopPendingApproval: true, events: events.length };
+        } finally { offApproval(); await api.aiSdkAgentCleanup(chat); }
+      })(${JSON.stringify(config)})`);
+      console.log(JSON.stringify(result));
+    }
+  } finally {
+    await fs.writeFile(path.join(scratch, 'model-requests.json'), JSON.stringify(service.requests, null, 2));
+    await cdp.evaluate(`Promise.all(['native-smoke-a','native-smoke-b'].map(id=>window.netcatty.closeSession(id)))`).catch(() => {});
+    cdp.close(); await service.close();
+  }
+  console.log(`Real Electron + CLIs + Netcatty MCP + local PTY; local controlled model only. ${scratch}`);
+}
+if (require.main === module) {
+  const timer = setTimeout(() => { console.error('Electron native smoke timed out'); process.exit(1); }, 180000);
+  main().then(() => clearTimeout(timer), (error) => { clearTimeout(timer); console.error(error); process.exitCode = 1; });
+}
+module.exports = { connect };
diff --git a/scripts/native-agents.live.cjs b/scripts/native-agents.live.cjs
new file mode 100644
index 00000000..78a6afcc
--- /dev/null
+++ b/scripts/native-agents.live.cjs
@@ -0,0 +1,131 @@
+"use strict";
+// Opt in: NETCATTY_NATIVE_RUNTIME=/path/to/installed/resources node scripts/native-agents.live.cjs
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { createNativeModelService } = require('./native-model-service.cjs');
+const { nativeSessionManager } = require('../electron/bridges/aiBridge/sdk/nativeSessionManager.cjs');
+const { createStreamEmitter } = require('../electron/bridges/aiBridge/sdk/emit.cjs');
+
+async function main() {
+  const root = process.env.NETCATTY_NATIVE_RUNTIME;
+  assert(root, 'Set NETCATTY_NATIVE_RUNTIME to the directory containing bin/omp and runtime/node_modules/.bin/{pi,dsh}');
+  const scratch = await fs.mkdtemp(path.join(root, 'smoke-'));
+  await fs.mkdir(path.join(scratch, 'tmp'));
+  let held;
+  const service = await createNativeModelService((body) => { if (JSON.stringify(body.messages.at(-1)).includes('NC_HOLD')) held?.(); });
+  try {
+    for (const engine of (process.env.NATIVE_ENGINES || 'dsh,pi,omp').split(',')) {
+      const driver = require(`../electron/bridges/aiBridge/sdk/${engine === 'dsh' ? 'dshNative' : engine + 'Rpc'}Driver.cjs`);
+      const dir = path.join(scratch, engine);
+      await fs.mkdir(dir);
+      const models = { providers: { 'netcatty-local': { baseUrl: `${service.url}/v1`, api: 'openai-completions', apiKey: 'local-test-key', models: [{ id: 'netcatty-smoke', name: 'Local controlled test', reasoning: false, input: ['text'], contextWindow: 64000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }] } } };
+      await fs.writeFile(path.join(dir, 'models.json'), JSON.stringify(models));
+      await fs.writeFile(path.join(dir, 'models.yml'), JSON.stringify(models));
+      let approvals = 0;
+      let allow = true;
+      const events = [];
+      const snapshots = [];
+      const answered = new Set();
+      let autoAnswer = true;
+      let onSnapshot;
+      const base = {
+        chatSessionId: `smoke-${engine}`, requestId: 'smoke', cwd: scratch,
+        binPath: engine === 'omp' ? path.join(root, 'bin/omp') : path.join(root, 'runtime/node_modules/.bin', engine),
+        model: engine === 'dsh' ? 'deepseek-official/deepseek-flash' : 'netcatty-local/netcatty-smoke',
+        env: { ...process.env, PI_CODING_AGENT_DIR: dir, DSH_HOME: path.join(dir, 'dsh'), DEEPSEEK_API_KEY: 'local-test-key', DEEPSEEK_BASE_URL: service.url, NETCATTY_NATIVE_LOCAL_TOOLS: 'confirm' },
+        toolIntegrationMode: 'mcp', injectedMcpServers: [], permissionMode: 'confirm',
+        getTempDir: () => path.join(scratch, 'tmp'),
+        requestApprovalFromRenderer: async () => { approvals++; return allow; },
+        clearPendingApprovals: () => {},
+        emitNativeSession: (snapshot) => {
+          snapshots.push(snapshot); onSnapshot?.(snapshot);
+          if (!autoAnswer) return;
+          for (const item of snapshot.interactions) {
+            if (answered.has(item.id)) continue;
+            answered.add(item.id);
+            const answer = item.questions ? { answers: item.questions.map((q) => ({ id: q.id, selected: [q.intent?.approve || 'Alpha'] })) } : { value: 'Extension reply' };
+            setImmediate(() => nativeSessionManager.get(base.chatSessionId)?.respond(item.id, answer));
+          }
+        },
+      };
+      const run = async (prompt, extra = {}) => {
+        const emitter = createStreamEmitter({ requestId: 'smoke', safeSend: (_sender, channel, payload) => events.push({ channel, ...payload }) });
+        return driver.runTurn({ ...base, prompt, emitter, ...extra });
+      };
+      const result = await run('NC_ECHO first native turn');
+      assert(events.some((entry) => entry.event?.textDelta?.includes('LOCAL_MODEL_OK')), `${engine}: missing streamed text`);
+      await nativeSessionManager.closeForChat(base.chatSessionId);
+      await run('NC_ECHO resumed second turn', { resumeSessionId: result.sessionId });
+      assert(JSON.stringify(service.requests.at(-1)).includes('first native turn'), `${engine}: history did not resume`);
+      await run('NC_TOOL approved local command');
+      await fs.writeFile(path.join(scratch, `${engine}-events.json`), JSON.stringify(events, null, 2));
+      assert(events.some((entry) => entry.event?.type === 'tool-result' && JSON.stringify(entry.event.output).includes('NATIVE_LOCAL_OK')), `${engine}: approved local command did not execute`);
+      assert(approvals > 0, `${engine}: local tool bypassed approval`);
+      assert(events.some((entry) => entry.event?.type === 'tool-result'), `${engine}: missing tool events`);
+      if (engine !== 'dsh') {
+        await run('/netcatty-check');
+        assert(snapshots.some((snapshot) => snapshot.widgets.some((widget) => widget.text.includes('Extension reply'))), `${engine}: extension answer was lost`);
+        if (engine === 'omp') {
+          let cancelled = false;
+          onSnapshot = (snapshot) => {
+            const task = snapshot.tasks.find((task) => task.status === 'started');
+            if (!task || cancelled) return;
+            cancelled = true;
+            void nativeSessionManager.get(base.chatSessionId).rpc.request('cancel_subagent', { subagentId: task.id });
+          };
+          await run('NC_TASK start a subagent');
+          onSnapshot = undefined;
+          assert(cancelled, 'OMP subagent was not presented or cancelled');
+        }
+      } else {
+        await run('NC_QUESTION ordinary question');
+        assert(answered.size, 'DSH question was not presented');
+        await nativeSessionManager.get(base.chatSessionId).rpc.request('plan_mode', { active: true });
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.active, true, 'DSH plan mode must be visible');
+        await run('NC_PLAN review the plan');
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.active, false, 'DSH reviewed plan must leave plan mode');
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.pending, undefined, 'Committed plan mode must clear the pending indicator');
+        assert(snapshots.some((snapshot) => snapshot.interactions.some((item) => item.questions?.some((q) => q.intent?.kind === 'plan-review'))), 'DSH plan review missing');
+        let killed = false;
+        onSnapshot = (snapshot) => {
+          const job = snapshot.tasks.find((task) => task.status === 'running');
+          if (!job || killed) return;
+          killed = true;
+          void nativeSessionManager.get(base.chatSessionId).rpc.request('job_kill', { jobId: job.id });
+        };
+        await run('NC_JOB start a background command');
+        onSnapshot = undefined;
+        assert(killed, 'DSH background task was not exposed');
+        assert(snapshots.some((snapshot) => snapshot.tasks.some((task) => task.status === 'killed')), 'DSH background task was not killed');
+        autoAnswer = false;
+        await run('NC_QUESTION deferred answer');
+        const session = nativeSessionManager.get(base.chatSessionId);
+        const pending = [...session.interactions.values()].find((item) => item.id.startsWith('continued:'));
+        assert(pending, 'DSH timed question disappeared instead of continuing');
+        const continued = new Promise((resolve) => { onSnapshot = (snapshot) => { if (snapshot.widgets.some((widget) => widget.id === 'continuation' && widget.text.includes('LOCAL_MODEL_OK'))) resolve(); }; });
+        session.respond(pending.id, { answers: [{ id: 'choice', selected: ['Alpha'] }] });
+        await continued;
+        onSnapshot = undefined; autoAnswer = true;
+      }
+      allow = false;
+      const approvalCount = approvals;
+      await run('NC_TOOL denied local command');
+      assert(approvals > approvalCount, `${engine}: denial was not requested`);
+      const abort = new AbortController();
+      const requestSeen = new Promise((resolve) => { held = resolve; });
+      const turn = run('NC_HOLD interrupt this request', { signal: abort.signal });
+      await requestSeen;
+      abort.abort();
+      await turn;
+      assert(!nativeSessionManager.get(base.chatSessionId), `${engine}: stopped process still registered`);
+      console.log(`${engine}: real CLI stream, tools/approval, denial, native resume, interactions${engine === 'dsh' ? '/plan/jobs' : ''} and stop PASS`);
+    }
+  } finally {
+    await fs.writeFile(path.join(scratch, 'model-requests.json'), JSON.stringify(service.requests, null, 2));
+    await nativeSessionManager.closeAll(); await service.close();
+  }
+  console.log(`Local controlled model only; artifacts: ${scratch}`);
+}
+const deadline = setTimeout(() => { console.error('Native smoke timed out'); void nativeSessionManager.closeAll().finally(() => process.exit(1)); }, 180000);
+main().then(() => clearTimeout(deadline), (error) => { clearTimeout(deadline); console.error(error); process.exitCode = 1; });
diff --git a/scripts/native-model-service.cjs b/scripts/native-model-service.cjs
new file mode 100644
index 00000000..cde75cd2
--- /dev/null
+++ b/scripts/native-model-service.cjs
@@ -0,0 +1,62 @@
+"use strict";
+// A deterministic LOCAL test service, not a cloud model. Real CLIs call it over HTTP.
+const http = require('node:http');
+const { randomUUID } = require('node:crypto');
+
+async function createNativeModelService(onRequest = () => {}, port = 0) {
+  const requests = [];
+  const server = http.createServer(async (req, res) => {
+    if (req.method === 'GET') { res.setHeader('content-type', 'application/json'); res.end(JSON.stringify({ data: [{ id: 'netcatty-smoke', object: 'model' }] })); return; }
+    let raw = '';
+    for await (const chunk of req) raw += chunk;
+    const body = JSON.parse(raw);
+    requests.push(body); onRequest(body);
+    const messages = body.messages || [];
+    const index = messages.findLastIndex((message) => message.role === 'user' && /NC_(ECHO|TOOL|HOLD|REMOTE|EXEC|QUESTION|PLAN|JOB|TASK)/.test(JSON.stringify(message.content)));
+    const content = JSON.stringify(messages[index]?.content || '');
+    // Anthropic adapters merge consecutive user messages after an interrupted
+    // turn. Act on the latest test instruction, not an earlier NC_HOLD block.
+    const marker = [...content.matchAll(/NC_(ECHO|TOOL|HOLD|REMOTE|EXEC|QUESTION|PLAN|JOB|TASK)/g)].at(-1);
+    const prompt = content.slice(marker?.index || 0);
+    if (prompt.includes('NC_HOLD')) { res.writeHead(200, { 'content-type': 'text/event-stream' }); res.write(': waiting for cancellation\n\n'); return; }
+    const usedTool = messages.slice(index + 1).some((message) => message.role === 'tool' || JSON.stringify(message.content).includes('tool_result'));
+    const tools = (body.tools || []).map((tool) => tool.function || tool);
+    const tool = !usedTool && prompt.includes('NC_QUESTION') ? tools.find((item) => item.name === 'ask_user_question')
+      : !usedTool && prompt.includes('NC_PLAN') ? tools.find((item) => item.name === 'exit_plan_mode')
+      : !usedTool && prompt.includes('NC_JOB') ? tools.find((item) => item.name === 'bash')
+      : !usedTool && prompt.includes('NC_TASK') ? tools.find((item) => item.name === 'task')
+      : !usedTool && prompt.includes('NC_EXEC')
+      ? tools.find((item) => /terminal_execute$/.test(item.name))
+      : !usedTool && prompt.includes('NC_REMOTE')
+      ? tools.find((item) => /get_environment$/.test(item.name))
+      : !usedTool && prompt.includes('NC_TOOL') ? tools.find((item) => item.name === 'bash') : null;
+    const args = prompt.includes('NC_QUESTION') ? { questions: [{ id: 'choice', question: 'Choose a test option', options: [{ label: 'Alpha' }, { label: 'Beta' }] }], timeout: prompt.includes('deferred') ? 1 : -1 }
+      : prompt.includes('NC_PLAN') ? { plan: '# Native integration plan\n\n1. Inspect the selected terminal.\n2. Report the result.' }
+      : prompt.includes('NC_JOB') ? { command: 'printf NATIVE_JOB_STARTED; sleep 30', run_in_background: true }
+      : prompt.includes('NC_TASK') ? { agent: 'task', task: 'NC_HOLD child task', solutionSpace: 'Only respond to this text; use no tools.', tools: [], model: body.model }
+      : prompt.includes('NC_EXEC') ? { sessionId: 'native-smoke-a', command: 'printf NETCATTY_MCP_CLI_OK' }
+      : prompt.includes('NC_REMOTE') ? {} : { command: 'printf NATIVE_LOCAL_OK' };
+    if (tool && (tool.input_schema?.required || tool.parameters?.required || []).includes('description')) args.description = 'Print a local integration marker';
+    const text = `LOCAL_MODEL_OK \u4e2d\u6587 ${usedTool ? 'tool returned' : 'echo'}`;
+    const id = randomUUID();
+    res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache' });
+    if (req.url.includes('/messages')) {
+      const send = (type, data) => res.write(`event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`);
+      send('message_start', { message: { id, type: 'message', role: 'assistant', model: body.model, content: [], stop_reason: null, usage: { input_tokens: 12, output_tokens: 0 } } });
+      send('content_block_start', { index: 0, content_block: tool ? { type: 'tool_use', id, name: tool.name, input: {} } : { type: 'text', text: '' } });
+      send('content_block_delta', { index: 0, delta: tool ? { type: 'input_json_delta', partial_json: JSON.stringify(args) } : { type: 'text_delta', text } });
+      send('content_block_stop', { index: 0 });
+      send('message_delta', { delta: { stop_reason: tool ? 'tool_use' : 'end_turn', stop_sequence: null }, usage: { output_tokens: 8 } });
+      send('message_stop', {});
+    } else {
+      const send = (delta, finish_reason = null) => res.write(`data: ${JSON.stringify({ id, object: 'chat.completion.chunk', created: 1, model: body.model, choices: [{ index: 0, delta, finish_reason }], usage: { prompt_tokens: 12, completion_tokens: 8, total_tokens: 20 } })}\n\n`);
+      send(tool ? { role: 'assistant', tool_calls: [{ index: 0, id, type: 'function', function: { name: tool.name, arguments: JSON.stringify(args) } }] } : { role: 'assistant', content: text });
+      send({}, tool ? 'tool_calls' : 'stop');
+      res.write('data: [DONE]\n\n');
+    }
+    res.end();
+  });
+  await new Promise((resolve) => server.listen(port, '127.0.0.1', resolve));
+  return { url: `http://127.0.0.1:${server.address().port}`, requests, close: () => { server.closeAllConnections(); return new Promise((resolve) => server.close(resolve)); } };
+}
+module.exports = { createNativeModelService };
