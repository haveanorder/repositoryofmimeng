+"use strict";
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { nativeEntry } = require('./nativeCli.cjs');
+
+test('Windows npm shims locate the pinned Pi entry even when package exports hide its manifest', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'netcatty-native-cli-'));
+  try {
+    const modules = path.join(root, 'node_modules');
+    const pkg = path.join(modules, '@earendil-works/pi-coding-agent');
+    fs.mkdirSync(path.join(pkg, 'dist/bundle'), { recursive: true });
+    fs.mkdirSync(path.join(modules, '.bin'), { recursive: true });
+    fs.writeFileSync(path.join(pkg, 'package.json'), JSON.stringify({ exports: { '.': { import: './dist/index.js' } }, bin: { pi: 'dist/bundle/cli.js' } }));
+    const expected = path.join(pkg, 'dist/bundle/cli.js');
+    fs.writeFileSync(expected, '');
+    for (const shim of [path.join(root, 'pi.cmd'), path.join(modules, '.bin/pi.cmd')]) {
+      fs.writeFileSync(shim, '@echo off\r\n');
+      assert.equal(nativeEntry(shim, 'pi'), expected);
+    }
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
