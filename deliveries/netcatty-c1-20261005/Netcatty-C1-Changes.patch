+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { OmpFrameDecoder } = require('./nativeRpcConnection.cjs');
+
+test('OMP v2 joins byte chunks before decoding UTF-8 and preserves Unicode line separators', () => {
+  const value = { type: 'message_update', text: '\u4e2d\u6587\u2028next' };
+  const bytes = Buffer.from(JSON.stringify(value));
+  const cut = bytes.indexOf(Buffer.from('\u4e2d')) + 1;
+  const chunks = [bytes.subarray(0, cut), bytes.subarray(cut)];
+  const decoder = new OmpFrameDecoder();
+  const frames = chunks.map((chunk, index) => ({ type: 'rpc_chunk', chunkId: 'one', index, count: 2, byteLength: bytes.length, data: chunk.toString('base64') }));
+  assert.equal(decoder.decode(frames[0]), null);
+  assert.deepEqual(decoder.decode(frames[1]), value);
+  const broken = new OmpFrameDecoder();
+  broken.decode(frames[0]);
+  assert.throws(() => broken.decode({ ...frames[1], index: 0 }), /sequence/);
+});
