+import React, { useState } from 'react';
+import { ClipboardList, Loader2, Square, X } from 'lucide-react';
+import { Button } from '../ui/button';
+import { useI18n } from '../../application/i18n/I18nProvider';
+import { useNativeAgentSession } from '../../application/state/useNativeAgentSession';
+import { NATIVE_AGENTS, type NativeInteraction, type NativeEngine, type NativeQuestion } from '../../infrastructure/ai/nativeAgents';
+
+function Interaction({ item, engine, disabled, respond }: { item: NativeInteraction; engine: NativeEngine; disabled: boolean; respond: (answer: Record<string, unknown>) => void }) {
+  const { t } = useI18n();
+  const [text, setText] = useState(item.prefill || '');
+  const [selected, setSelected] = useState<Record<string, string[]>>({});
+  const [custom, setCustom] = useState<Record<string, string>>({});
+  const questions: NativeQuestion[] = item.questions || [];
+  const review = questions.some((question) => question.intent?.kind === 'plan-review');
+  const submit = () => {
+    if (questions.length) respond({ answers: questions.map((question) => engine === 'dsh'
+      ? { id: question.id, selected: selected[question.id] || [], custom: custom[question.id] || undefined }
+      : { id: question.id, selectedOptions: selected[question.id] || [], customInput: custom[question.id] || undefined }) });
+    else respond({ value: text });
+  };
+  return <div className={'rounded-lg border p-3 space-y-3 ' + (review ? 'border-primary/40 bg-primary/5' : 'border-border/70 bg-card/70')}>
+    <p className="flex items-center gap-2 text-sm font-medium">{review && <ClipboardList size={15} />}{review ? t('ai.native.planReview') : item.title || t('ai.native.question')}</p>
+    {item.message && <p className="text-xs whitespace-pre-wrap">{item.message}</p>}
+    {questions.map((question) => {
+      const plan = question.intent?.kind === 'plan-review';
+      return <fieldset disabled={disabled} key={question.id} className="space-y-2 text-xs">
+        <legend className="font-medium mb-2">{plan ? t('ai.native.planReviewQuestion') : [question.header, question.question].filter(Boolean).join(' · ')}</legend>
+        {question.detail && <pre className="whitespace-pre-wrap max-h-80 overflow-auto rounded bg-background/70 p-3 font-sans leading-relaxed">{question.detail}</pre>}
+        {question.options?.map((option) => {
+          const approved = option.label === question.intent?.approve;
+          return <label key={option.label} className="flex gap-2 items-start rounded-md border border-border/50 p-2 cursor-pointer has-[:checked]:border-primary/60">
+            <input className="mt-0.5" type={question.multi || question.multiSelect ? 'checkbox' : 'radio'} name={item.id + '-' + question.id} checked={(selected[question.id] || []).includes(option.label)} onChange={(event) => setSelected((old) => ({ ...old, [question.id]: question.multi || question.multiSelect ? event.target.checked ? [...(old[question.id] || []), option.label] : (old[question.id] || []).filter((label) => label !== option.label) : [option.label] }))} />
+            <span>{plan ? t(approved ? 'ai.native.approvePlan' : 'ai.native.keepPlanning') : option.label}<span className="block text-muted-foreground mt-1">{plan ? t(approved ? 'ai.native.approvePlanHint' : 'ai.native.keepPlanningHint') : option.description}</span></span>
+          </label>;
+        })}
+        <textarea aria-label={t('ai.native.customAnswer')} className="w-full rounded border border-input bg-background p-2" value={custom[question.id] || ''} onChange={(event) => setCustom((old) => ({ ...old, [question.id]: event.target.value }))} placeholder={t('ai.native.customAnswer')} />
+      </fieldset>;
+    })}
+    {item.method === 'select' && <select disabled={disabled} aria-label={t('ai.native.selectAnswer')} className="w-full bg-background border rounded p-2 text-xs" value={text} onChange={(event) => setText(event.target.value)}><option value="">{t('ai.native.selectAnswer')}</option>{item.options?.map((option) => <option key={option}>{option}</option>)}</select>}
+    {['input', 'editor'].includes(item.method) && <textarea disabled={disabled} aria-label={item.title || t('ai.native.answer')} className="w-full rounded border border-input bg-background p-2 text-xs" value={text} onChange={(event) => setText(event.target.value)} />}
+    <div className="flex flex-wrap gap-2">
+      {item.method === 'confirm' ? <><Button size="sm" disabled={disabled} onClick={() => respond({ confirmed: true })}>{t('ai.native.yes')}</Button><Button size="sm" variant="outline" disabled={disabled} onClick={() => respond({ confirmed: false })}>{t('ai.native.no')}</Button></> : <Button size="sm" onClick={submit} disabled={disabled || (questions.length ? questions.some((question) => !selected[question.id]?.length && !custom[question.id]?.trim()) : !text.trim())}>{t('ai.native.sendAnswer')}</Button>}
+      <Button size="sm" variant="ghost" disabled={disabled} onClick={() => respond({ cancelled: true })}>{t('ai.native.cancel')}</Button>
+    </div>
+  </div>;
+}
+
+export function NativeAgentPanel({ chatSessionId }: { chatSessionId?: string }) {
+  const { t } = useI18n();
+  const { snapshot, result, clearResult, error, pending, control, stop } = useNativeAgentSession(chatSessionId);
+  const [steering, setSteering] = useState<Record<string, string>>({});
+  if (!snapshot) return null;
+  const closed = snapshot.status === 'closed' || snapshot.status === 'error';
+  const planActive = snapshot.plan?.pending ?? snapshot.plan?.active;
+  const statusText = (status?: string) => {
+    const key = 'ai.native.status.' + status;
+    return t(key) === key ? status || t('ai.native.unknown') : t(key);
+  };
+  return <div className="space-y-3 border-t border-border/60 pt-3" data-native-engine={snapshot.engine}>
+    <div className="flex items-center justify-between gap-2 text-xs">
+      <div className="min-w-0"><p className="font-medium">{NATIVE_AGENTS[snapshot.engine].name} <span className="text-muted-foreground font-normal">{snapshot.version}</span></p><p className="text-muted-foreground" role="status">{statusText(snapshot.status)}</p></div>
+      <Button variant="ghost" size="sm" disabled={closed || pending === 'stop'} onClick={() => void stop()}>{pending === 'stop' ? <Loader2 size={13} className="mr-1 animate-spin" /> : <Square size={12} className="mr-1" />}{t(pending === 'stop' ? 'ai.native.stopping' : 'ai.native.stop')}</Button>
+    </div>
+    {closed && <p className="text-xs text-muted-foreground">{t('ai.native.closedHint')}</p>}
+    {snapshot.engine === 'dsh' && <div className="flex items-center justify-between gap-2 rounded-md bg-muted/40 px-2 py-1 text-xs"><div><span>{t(planActive ? 'ai.native.planOn' : 'ai.native.planOff')}</span>{snapshot.plan?.pending !== undefined && <p className="text-muted-foreground">{t('ai.native.planPending')}</p>}</div><Button size="sm" variant="ghost" disabled={closed || Boolean(pending)} onClick={() => void control({ action: planActive ? 'plan-off' : 'plan-on' })}>{t(planActive ? 'ai.native.leavePlan' : 'ai.native.enterPlan')}</Button></div>}
+    {snapshot.interactions.map((item) => <Interaction key={item.id} item={item} engine={snapshot.engine} disabled={closed || Boolean(pending)} respond={(answer) => void control({ action: 'respond', id: item.id, answer })} />)}
+    {snapshot.widgets.map((widget) => <div key={widget.id} className="rounded-md bg-muted/30 p-2">{widget.id === 'continuation' && <p className="mb-1 text-xs font-medium">{t('ai.native.continuation')}</p>}<pre className="text-xs whitespace-pre-wrap max-h-60 overflow-auto font-sans leading-relaxed">{widget.text}</pre></div>)}
+    {snapshot.tasks.length > 0 && <p className="text-xs font-medium">{t('ai.native.tasks', { count: snapshot.tasks.length })}</p>}
+    {snapshot.tasks.map((task) => {
+      const finished = ['completed', 'failed', 'aborted', 'cancelled', 'killed', 'exited'].includes(task.status || '');
+      return <div key={task.id} className="rounded-lg border border-border/60 p-3 text-xs space-y-2">
+        <div className="flex items-start justify-between gap-2"><p className="font-medium break-words">{task.name || task.title || task.id}</p><span className="shrink-0 text-muted-foreground">{statusText(task.status)}</span></div>
+        {task.progress != null && <details><summary className="cursor-pointer text-muted-foreground">{t('ai.native.progress')}</summary><pre className="whitespace-pre-wrap max-h-40 overflow-auto mt-1">{typeof task.progress === 'string' ? task.progress : JSON.stringify(task.progress, null, 2)}</pre></details>}
+        <div className="flex gap-2"><Button size="sm" variant="outline" disabled={closed || Boolean(pending)} onClick={() => void control({ action: 'task-read', id: task.id })}>{t('ai.native.readOutput')}</Button><Button size="sm" variant="ghost" disabled={closed || finished || Boolean(pending)} onClick={() => void control({ action: 'task-cancel', id: task.id })}>{t('ai.native.stopTask')}</Button></div>
+        {snapshot.engine === 'omp' && !finished && <div className="flex gap-2"><input disabled={closed} aria-label={t('ai.native.subagentMessage')} placeholder={t('ai.native.subagentMessage')} className="min-w-0 flex-1 rounded border bg-background px-2" value={steering[task.id] || ''} onChange={(event) => setSteering((old) => ({ ...old, [task.id]: event.target.value }))} /><Button size="sm" disabled={closed || Boolean(pending) || !steering[task.id]?.trim()} onClick={() => { void control({ action: 'task-steer', id: task.id, message: steering[task.id] }); setSteering((old) => ({ ...old, [task.id]: '' })); }}>{t('ai.native.send')}</Button></div>}
+      </div>;
+    })}
+    {error && <p role="alert" className="text-xs text-destructive break-words">{error}</p>}
+    {result && <div className="rounded-lg border border-border/60 p-3"><div className="mb-2 flex items-center justify-between text-xs font-medium">{t('ai.native.output')}<Button aria-label={t('ai.native.closeOutput')} size="sm" variant="ghost" onClick={clearResult}><X size={13} /></Button></div><pre className="max-h-72 overflow-auto whitespace-pre-wrap text-xs select-text">{result}</pre></div>}
+  </div>;
+}
