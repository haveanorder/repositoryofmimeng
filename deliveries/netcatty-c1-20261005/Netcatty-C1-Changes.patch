+// Deliberately limited to the native RPC UI contract supported by Netcatty.
+export default function netcattyExtension(pi) {
+  const config = JSON.parse(process.env.NETCATTY_NATIVE_CONFIG || '{}');
+  if (config.engine === 'pi') {
+    for (const server of config.mcpServers || []) {
+      pi.registerMcpServer(server.name, {
+        command: server.command, args: server.args,
+        env: Object.fromEntries(server.env.map(({ name, value }) => [name, value])),
+        exposure: 'direct', timeout: 300000,
+      });
+    }
+  }
+  pi.on('tool_call', async (event, ctx) => {
+    const remote = config.engine === 'omp'
+      ? event.toolName.startsWith('netcatty__')
+      : (config.mcpServers || []).some((server) => event.toolName.startsWith(`mcp__${server.name}__`));
+    if (remote || (config.engine === 'omp' && ['ask', 'todo', 'wait'].includes(event.toolName))) return;
+    if (config.localTools !== 'confirm' || config.permissionMode === 'observer') {
+      return { block: true, reason: 'Local tools are disabled. Use Netcatty MCP for connected terminals.' };
+    }
+    const approved = await ctx.ui.confirm('Netcatty local tool', JSON.stringify({ tool: event.toolName, args: event.input, cwd: ctx.cwd }));
+    if (!approved || ctx.signal?.aborted) return { block: true, reason: 'Local tool denied or cancelled.' };
+  });
+  pi.registerCommand('netcatty-check', {
+    description: 'Check the Netcatty extension interaction',
+    handler: async (_args, ctx) => {
+      const value = await ctx.ui.input('Netcatty extension check', 'Enter a short message');
+      ctx.ui.setWidget('netcatty-check', [value === undefined ? 'Cancelled' : `Received: ${value}`]);
+    },
+  });
+}
