diff --git a/scripts/windows-1183-acceptance.ps1 b/scripts/windows-1183-acceptance.ps1
new file mode 100644
index 0000000..52a4d79
--- /dev/null
+++ b/scripts/windows-1183-acceptance.ps1
@@ -0,0 +1,63 @@
+param([string]$SourceDir, [string]$DeliveryDir)
+$ErrorActionPreference = 'Stop'
+$SourceDir = (Resolve-Path $SourceDir).Path
+$DeliveryDir = (Resolve-Path $DeliveryDir).Path
+$Root = (Get-Location).Path
+$env:NATIVE_ELECTRON_PORT = '9283'
+function Assert-Exit([string]$Message) { if ($LASTEXITCODE) { throw $Message } }
+function Run-Node([string]$Script, [string]$Argument = '') {
+    & node (Join-Path $SourceDir "scripts\$Script") $Argument
+    Assert-Exit $Script
+}
+function Start-Netcatty {
+    $script:App = Start-Process (Join-Path $Trial 'Netcatty.exe') -ArgumentList "--remote-debugging-port=9283 --user-data-dir=`"$Profile`" --disable-gpu" -PassThru -RedirectStandardOutput (Join-Path $Root "electron-$Phase.out.log") -RedirectStandardError (Join-Path $Root "electron-$Phase.err.log")
+    $Ready = $false
+    for ($i = 0; $i -lt 120; $i++) {
+        try {
+            $Pages = Invoke-RestMethod 'http://127.0.0.1:9283/json/list'
+            if (@($Pages | Where-Object { $_.type -eq 'page' -and $_.url -match 'index.html' -and $_.url -notmatch 'settings' }).Count) { $Ready = $true; break }
+        } catch { }
+        if ($App.HasExited) { throw "Netcatty exited at $Phase" }
+        Start-Sleep -Milliseconds 500
+    }
+    if (!$Ready) { throw "Netcatty renderer not ready at $Phase" }
+    Start-Sleep -Seconds 2
+}
+function Stop-Netcatty {
+    Run-Node 'native-profile.live.cjs' 'quit'
+    if (!$App.WaitForExit(30000)) { throw 'Netcatty did not quit normally' }
+    Start-Sleep -Seconds 1
+}
+Invoke-WebRequest 'https://github.com/binaricat/Netcatty/releases/download/v1.1.83/Netcatty-1.1.83-win-x64.zip' -OutFile official.zip
+Expand-Archive official.zip -DestinationPath 'Trial Install With Spaces'
+$Trial = Join-Path $Root 'Trial Install With Spaces'
+$Profile = Join-Path $Root 'Acceptance Existing Profile'
+Expand-Archive (Join-Path $DeliveryDir 'Netcatty-1.1.83-C1-Windows-x64-Patch.zip') -DestinationPath patch
+$Patch = Join-Path $Root 'patch\scripts\windows-1183-patch.ps1'
+$ExeHash = (Get-FileHash (Join-Path $Trial 'Netcatty.exe')).Hash
+$AsarHash = (Get-FileHash (Join-Path $Trial 'resources\app.asar')).Hash
+$Phase = 'original'
+try {
+    Start-Netcatty
+    Run-Node 'native-profile.live.cjs' 'seed'
+    Stop-Netcatty
+    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $Patch -Action check -InstallDir $Trial; Assert-Exit 'Patch check'
+    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $Patch -Action apply -InstallDir $Trial; Assert-Exit 'Patch apply'
+    if ((Get-FileHash (Join-Path $Trial 'Netcatty.exe')).Hash -ne $ExeHash) { throw 'Executable changed' }
+    $Phase = 'patched'
+    Start-Netcatty
+    Run-Node 'native-profile.live.cjs' 'verify'
+    Run-Node 'native-agents.ui.live.cjs'
+    Run-Node 'native-agents.electron.live.cjs'
+    Stop-Netcatty
+    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $Patch -Action rollback -InstallDir $Trial; Assert-Exit 'Patch rollback'
+    if ((Get-FileHash (Join-Path $Trial 'resources\app.asar')).Hash -ne $AsarHash) { throw 'Rollback resources differ' }
+    if ((Get-FileHash (Join-Path $Trial 'Netcatty.exe')).Hash -ne $ExeHash) { throw 'Rollback executable differs' }
+    $Phase = 'rollback'
+    Start-Netcatty
+    Run-Node 'native-profile.live.cjs' 'verify'
+    Stop-Netcatty
+    Write-Output 'WINDOWS PASS: original entry; check/apply/backup/rollback; retained host/key/chat/Codex/settings/DPAPI; target CLI settings/sidebar/MCP/interaction/resume/approval/stop. LOCAL controlled model only.'
+} finally {
+    Get-Process Netcatty -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
+}
diff --git a/scripts/windows-1183-patch.ps1 b/scripts/windows-1183-patch.ps1
new file mode 100644
index 0000000..1a55ede
--- /dev/null
+++ b/scripts/windows-1183-patch.ps1
@@ -0,0 +1,127 @@
+param(
+    [ValidateSet('menu', 'check', 'apply', 'rollback')][string]$Action = 'menu',
+    [string]$InstallDir
+)
+$ErrorActionPreference = 'Stop'
+$PatchRoot = $PSScriptRoot
+if (Test-Path (Join-Path $PatchRoot '..\manifest.json')) { $PatchRoot = Split-Path $PatchRoot }
+$Manifest = Get-Content (Join-Path $PatchRoot 'manifest.json') -Raw -Encoding UTF8 | ConvertFrom-Json
+function Hash([string]$File) { (Get-FileHash -LiteralPath $File -Algorithm SHA256).Hash.ToLowerInvariant() }
+function Locate-Install {
+    $Candidates = @()
+    foreach ($RegistryRoot in @('HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall', 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall')) {
+        Get-ItemProperty "$RegistryRoot\*" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq 'Netcatty' } | ForEach-Object {
+            if ($_.InstallLocation) { $Candidates += $_.InstallLocation }
+            if ($_.UninstallString -match '^"([^"]+)"') { $Candidates += Split-Path $Matches[1] }
+        }
+    }
+    $Candidates += @((Join-Path $env:LOCALAPPDATA 'Programs\Netcatty'), (Join-Path $env:ProgramFiles 'Netcatty'))
+    $Found = @($Candidates | Where-Object { Test-Path (Join-Path $_ 'Netcatty.exe') } | Select-Object -Unique)
+    if ($Found.Count -eq 1) { return $Found[0] }
+    Add-Type -AssemblyName System.Windows.Forms
+    $Picker = New-Object System.Windows.Forms.FolderBrowserDialog
+    $Picker.Description = '请选择包含 Netcatty.exe 的安装目录'
+    if ($Found.Count) { $Picker.SelectedPath = $Found[0] }
+    if ($Picker.ShowDialog() -ne 'OK') { throw '已取消目录选择。' }
+    $Picker.SelectedPath
+}
+function Check-Install {
+    $Exe = Join-Path $InstallDir 'Netcatty.exe'
+    if (!(Test-Path $Exe)) { throw '所选目录中没有 Netcatty.exe。' }
+    $Version = (Get-Item -LiteralPath $Exe).VersionInfo.ProductVersion
+    if ($Version -notmatch '^1\.1\.83(?:\.0)?$') { throw "此补丁适用于 1.1.83；检测到 $Version。" }
+    $Stream = [IO.File]::OpenRead($Exe)
+    $Reader = New-Object IO.BinaryReader($Stream)
+    try { $Stream.Position = 60; $Offset = $Reader.ReadInt32(); $Stream.Position = $Offset + 4; if ($Reader.ReadUInt16() -ne 34404) { throw '需要 Windows x64 版本。' } }
+    finally { $Reader.Dispose(); $Stream.Dispose() }
+    $Core = $Manifest.files | Where-Object { $_.path -eq 'resources/app.asar' }
+    $Current = Hash (Join-Path $InstallDir $Core.path)
+    if ($Current -ne $Core.originalSha256 -and $Current -ne $Core.sha256) { throw '应用资源与官方 1.1.83 及本补丁均不匹配。没有修改任何文件。' }
+    foreach ($File in $Manifest.files) {
+        if ((Hash (Join-Path $PatchRoot ('payload\' + $File.path))) -ne $File.sha256) { throw "补丁文件校验失败：$($File.path)" }
+    }
+    Write-Host "目录：$InstallDir"
+    Write-Host "Netcatty $Version / Windows x64；资源检查通过。"
+    Write-Host '保持当前启动入口和用户数据目录；只修改清单中的应用资源。'
+    return $Current -eq $Core.sha256
+}
+function Require-Stopped {
+    $Running = @(Get-Process -Name Netcatty -ErrorAction SilentlyContinue)
+    if ($Running.Count) { throw '请先退出所有 Netcatty 窗口和托盘进程，再应用或回滚。' }
+}
+function Restore-Files($Receipt) {
+    foreach ($File in $Receipt.files) {
+        $Destination = Join-Path $InstallDir $File.path
+        if ($File.existed) {
+            $Saved = Join-Path $BackupDir $File.path
+            if ((Hash $Saved) -ne $File.sha256) { throw "备份校验失败：$($File.path)" }
+        }
+    }
+    foreach ($File in $Receipt.files) {
+        $Destination = Join-Path $InstallDir $File.path
+        if ($File.existed) { Copy-Item -LiteralPath (Join-Path $BackupDir $File.path) -Destination $Destination -Force }
+        elseif (Test-Path $Destination) { Remove-Item -LiteralPath $Destination -Force }
+    }
+}
+try {
+    if (!$InstallDir) { $InstallDir = Locate-Install }
+    $InstallDir = (Resolve-Path -LiteralPath $InstallDir).Path
+    $BackupDir = Join-Path $InstallDir '.netcatty-c1-1183-backup'
+    $ReceiptFile = Join-Path $BackupDir 'backup.json'
+    if ($Action -eq 'menu') {
+        Write-Host "Netcatty 1.1.83 C1 功能补丁`n目录：$InstallDir"
+        Write-Host '1 检查   2 应用   3 回滚   0 退出'
+        switch (Read-Host '请选择') { '1' { $Action = 'check' } '2' { $Action = 'apply' } '3' { $Action = 'rollback' } default { exit 0 } }
+    }
+    if ($Action -eq 'rollback') {
+        Require-Stopped
+        if (!(Test-Path $ReceiptFile)) { throw '此目录没有本补丁的备份。' }
+        $Receipt = Get-Content $ReceiptFile -Raw -Encoding UTF8 | ConvertFrom-Json
+        $Core = $Manifest.files | Where-Object { $_.path -eq 'resources/app.asar' }
+        $Current = Hash (Join-Path $InstallDir $Core.path)
+        if ($Current -ne $Core.sha256 -and $Current -ne $Core.originalSha256) { throw '程序已被其他更新修改；请保留当前程序后再处理备份。' }
+        Restore-Files $Receipt
+        Write-Host '已恢复官方 1.1.83 程序资源。当前主机、密钥、设置和聊天数据仍保留；备份也已保留。'
+    } else {
+        $AlreadyApplied = Check-Install
+        if ($Action -eq 'apply') {
+            Require-Stopped
+            if ($AlreadyApplied) { Write-Host '此补丁已经应用。'; exit 0 }
+            if (Test-Path $ReceiptFile) {
+                $Receipt = Get-Content $ReceiptFile -Raw -Encoding UTF8 | ConvertFrom-Json
+                foreach ($File in $Receipt.files) { if ($File.existed -and (Hash (Join-Path $BackupDir $File.path)) -ne $File.sha256) { throw '已有备份不完整。' } }
+            } else {
+                New-Item -ItemType Directory -Path $BackupDir -Force | Out-Null
+                $Entries = @()
+                foreach ($File in $Manifest.files) {
+                    $Original = Join-Path $InstallDir $File.path
+                    $Exists = Test-Path $Original
+                    $OriginalHash = $null
+                    if ($Exists) {
+                        $OriginalHash = Hash $Original
+                        $Saved = Join-Path $BackupDir $File.path
+                        New-Item -ItemType Directory -Path (Split-Path $Saved) -Force | Out-Null
+                        Copy-Item -LiteralPath $Original -Destination $Saved
+                    }
+                    $Entries += @{ path = $File.path; existed = $Exists; sha256 = $OriginalHash }
+                }
+                $Receipt = @{ patch = $Manifest.patch; files = $Entries }
+                $Receipt | ConvertTo-Json -Depth 8 | Set-Content $ReceiptFile -Encoding UTF8
+            }
+            try {
+                foreach ($File in $Manifest.files) {
+                    $Destination = Join-Path $InstallDir $File.path
+                    New-Item -ItemType Directory -Path (Split-Path $Destination) -Force | Out-Null
+                    Copy-Item -LiteralPath (Join-Path $PatchRoot ('payload\' + $File.path)) -Destination $Destination -Force
+                    if ((Hash $Destination) -ne $File.sha256) { throw "写入校验失败：$($File.path)" }
+                }
+            } catch { Restore-Files $Receipt; throw }
+            Write-Host '补丁已应用。通过原快捷方式启动 Netcatty，在 设置 → AI → Agents 配置三个已有 Agent。'
+            Write-Host "原程序资源备份：$BackupDir"
+        }
+    }
+} catch {
+    Write-Host $_.Exception.Message -ForegroundColor Red
+    if ($_.Exception -is [UnauthorizedAccessException]) { Write-Host '安装目录需要写权限。请右键补丁入口，以管理员身份运行。' }
+    exit 1
+}
