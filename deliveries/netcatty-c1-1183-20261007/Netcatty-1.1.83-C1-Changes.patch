new file mode 100644
index 0000000..3e8132b
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/nativeCli.cjs
@@ -0,0 +1,29 @@
+"use strict";
+const fs = require('node:fs');
+const path = require('node:path');
+const { prepareCommandForSpawn, resolveCliFromPath } = require('../../ai/shellUtils.cjs');
+
+// Keep Windows launchers intact: Pi's installer can bundle its own runtime
+// beside pi.cmd, while npm uses node_modules. Both own their launch details.
+function nativeEntry(command) {
+  return fs.realpathSync(command);
+}
+function resolveNativeCli(engine, env) {
+  const found = resolveCliFromPath(engine, env);
+  if (found || process.platform !== 'win32') return found;
+  const user = env.USERPROFILE;
+  const candidates = {
+    omp: env.LOCALAPPDATA && path.join(env.LOCALAPPDATA, 'omp', 'omp.exe'),
+    pi: user && path.join(user, '.pi', 'agent', 'bin', 'pi.cmd'),
+    dsh: env.APPDATA && path.join(env.APPDATA, 'npm', 'dsh.cmd'),
+  };
+  const candidate = candidates[engine];
+  return candidate && fs.existsSync(candidate) ? candidate : null;
+}
+function prepareNativeCommand(command, args, env) {
+  if (/\.[cm]?js$/i.test(command)) {
+    return { command: resolveCliFromPath('node', env) || 'node', args: [command, ...args], shell: false };
+  }
+  return prepareCommandForSpawn(command, args, { unwrapNativeExe: false });
+}
+module.exports = { nativeEntry, prepareNativeCommand, resolveNativeCli };
diff --git a/electron/bridges/aiBridge/sdk/nativeCli.test.cjs b/electron/bridges/aiBridge/sdk/nativeCli.test.cjs
