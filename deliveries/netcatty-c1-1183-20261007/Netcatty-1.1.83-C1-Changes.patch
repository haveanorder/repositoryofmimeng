diff --git a/packages/netcatty-dsh-bridge/bridge.mjs b/packages/netcatty-dsh-bridge/bridge.mjs
new file mode 100644
index 0000000..dad7c54
--- /dev/null
+++ b/packages/netcatty-dsh-bridge/bridge.mjs
@@ -0,0 +1,179 @@
+import process from 'node:process';
+import { setImmediate } from 'node:timers';
+// DSH 0.2.0-rc.2 profile plugin. The CLI owns boot, persistence and agent loop.
+import { createRequire } from 'node:module';
+import { realpathSync } from 'node:fs';
+import { pathToFileURL } from 'node:url';
+import { createInterface } from 'node:readline';
+import { randomUUID } from 'node:crypto';
+
+export const name = 'netcatty-native-bridge';
+export const inject = ['agents', 'tools', 'jobs', 'approval', 'userQuestions', 'planMode', 'agentDefaultModel'];
+
+export async function apply(ctx) {
+  const requireEngine = createRequire(realpathSync(process.env.NETCATTY_DSH_ENTRY));
+  const { createUserMessage } = await import(pathToFileURL(requireEngine.resolve('@deepseek-ai/dsh-llm')));
+  const { UserQuestionError } = await import(pathToFileURL(requireEngine.resolve('@deepseek-ai/dsh-user-questions')));
+  const send = (frame) => process.stdout.write(`${JSON.stringify(frame)}\n`);
+  const pending = new Map();
+  let handle;
+  let stopping = false;
+  let settling;
+  let activeTurnId;
+  const continuedQuestions = new Set();
+  const publishContinuedQuestions = () => {
+    if (!handle || stopping) return;
+    const projection = ctx.get('sessionProjections')?.stateOf(handle.agent.session, 'userQuestions');
+    for (const question of projection?.questions.active || []) {
+      if (question.state !== 'continued' || continuedQuestions.has(question.callId)) continue;
+      continuedQuestions.add(question.callId);
+      send({ type: 'interaction', id: `continued:${question.callId}`, kind: 'questions', questions: question.questions });
+    }
+  };
+  const owned = (agent) => agent && (agent === handle?.agent || ctx.agents.list().includes(agent));
+  const ask = (payload, signal) => new Promise((resolve) => {
+    const id = randomUUID();
+    const finish = (value) => {
+      if (!pending.delete(id)) return;
+      signal?.removeEventListener('abort', cancel);
+      send({ type: 'interaction-cleared', id });
+      resolve(value);
+    };
+    const cancel = () => finish({ cancelled: true });
+    pending.set(id, finish);
+    signal?.addEventListener('abort', cancel, { once: true });
+    send({ type: 'interaction', id, ...payload });
+    if (signal?.aborted) cancel();
+  });
+
+  ctx.on('approval/request', async (request) => {
+    const answer = await ask({ kind: 'approval', toolName: request.toolName, reason: request.reason }, request.signal);
+    return answer.cancelled ? 'cancelled' : answer.approved ? 'allowed-once' : 'rejected';
+  });
+  ctx.on('user-questions/request', async (request) => {
+    const answer = await ask({ kind: 'questions', questions: request.questions }, request.signal);
+    if (request.signal?.aborted) throw request.signal.reason;
+    if (answer.cancelled) throw new UserQuestionError('Question dismissed', 'ASK_CANCELLED');
+    return { answers: answer.answers || [] };
+  });
+  // Remote MCP always uses Netcatty's own policy. Local approval is independent.
+  ctx.on('tools/pre-execute', async (exec, next) => {
+    if (exec.name.startsWith('mcp__netcatty__')) return next();
+    const interactionTools = ['ask_user_question', 'exit_plan_mode', 'todo_write', 'job_list', 'job_output', 'job_kill'];
+    if (interactionTools.includes(exec.name)) return next();
+    if (process.env.NETCATTY_NATIVE_LOCAL_TOOLS !== 'confirm') {
+      return { kind: 'deny', reason: 'Local workspace tools are disabled in Netcatty settings. Use Netcatty MCP for connected terminals.' };
+    }
+    if (process.env.NETCATTY_NATIVE_PERMISSION === 'observer') return { kind: 'deny', reason: 'Observer mode blocks local tools.' };
+    const answer = await ask({ kind: 'approval', toolName: exec.name, args: exec.arguments }, exec.signal);
+    if (answer.cancelled) return { kind: 'cancel' };
+    return answer.approved ? next() : { kind: 'deny', reason: 'Local tool denied by user.' };
+  });
+  ctx.on('agent/assistant-stream', ({ agent, frame }) => {
+    if (agent === handle?.agent) send({ type: 'assistant-stream', frame });
+  });
+  ctx.on('session/event', (session, event) => {
+    if (session.id === handle?.agent.session.id) {
+      send({ type: 'session-event', event });
+      // PlanMode clears its pending intent after appending this event.
+      if (event.type === 'plan/mode') void Promise.resolve().then(() => send({ type: 'plan-state', plan: ctx.planMode.get(handle.agent) }));
+      void Promise.resolve().then(publishContinuedQuestions);
+    }
+  });
+  ctx.on('agent/status', ({ agent, status }) => {
+    if (owned(agent)) send({ type: 'agent-status', id: String(agent.id), primary: agent === handle?.agent, status });
+  });
+  ctx.effect(() => ctx.jobs.attachController('netcatty'), 'netcatty.jobs');
+  ctx.effect(() => ctx.jobs.events.subscribe({ owners: 'all' }, (event) => send({ type: 'job-event', event })), 'netcatty.job-events');
+
+  const stop = async () => {
+    stopping = true;
+    for (const finish of [...pending.values()]) finish({ cancelled: true });
+    for (const agent of ctx.agents.list()) {
+      agent.cancel({ kind: 'user' }); // Intentionally clears inbox (no keepInbox).
+      for (const job of ctx.jobs.list(agent.session.id)) ctx.jobs.kill(job.id, agent.session.id, 'Netcatty stop');
+    }
+    await Promise.all(ctx.agents.list().map((agent) => agent.whenIdle()));
+  };
+  const waitUntilSettled = async () => {
+    // whenIdle covers queues; Jobs are a separate service and can wake agents.
+    for (;;) {
+      await Promise.all(ctx.agents.list().map((agent) => agent.whenIdle()));
+      const liveJobs = ctx.agents.list().flatMap((agent) => ctx.jobs.list(agent.session.id))
+        .filter((job) => job.status === 'running' || job.status === 'stopping');
+      if (!liveJobs.length) break;
+      await new Promise((resolve) => {
+        const off = ctx.jobs.events.subscribe({ owners: 'all' }, (event) => {
+          if (event.type === 'settled') { off(); resolve(); }
+        });
+      });
+    }
+    send({ type: 'turn-settled', turnId: activeTurnId, cancelled: stopping });
+    activeTurnId = undefined;
+  };
+  const settle = () => {
+    settling ||= waitUntilSettled().catch((error) => send({ type: 'fatal', error: error.message })).finally(() => { settling = undefined; });
+    return settling;
+  };
+  const dispatch = async (command) => {
+    switch (command.type) {
+      case 'initialize': {
+        await ctx.get('loader')?.await();
+        const options = { ...ctx.agentDefaultModel.currentSelection(), ...(command.provider ? { provider: command.provider } : {}), ...(command.model ? { model: command.model } : {}) };
+        handle = command.resumeSessionId
+          ? await ctx.agents.resume({ resumeSessionId: command.resumeSessionId, agentOptions: options })
+          : await ctx.agents.create({ sessionId: `netcatty-${randomUUID()}`, meta: { cwd: command.cwd }, agentOptions: options });
+        publishContinuedQuestions();
+        return { sessionId: String(handle.agent.session.id), version: process.env.NETCATTY_DSH_VERSION, bridgeVersion: 1 };
+      }
+      case 'prompt': {
+        stopping = false;
+        activeTurnId = command.turnId;
+        const message = createUserMessage({ content: [{ type: 'text', text: command.message }], source: { kind: 'user' } });
+        handle.agent.followup(message);
+        void settle();
+        return { messageId: message.id };
+      }
+      case 'abort': await stop(); return {};
+      case 'snapshot': return { jobs: ctx.jobs.list(handle.agent.session.id), status: handle.agent.status, plan: ctx.planMode.get(handle.agent) };
+      case 'plan_mode': {
+        const result = ctx.planMode.set(handle.agent, command.active);
+        send({ type: 'plan-state', plan: ctx.planMode.get(handle.agent) });
+        return { result };
+      }
+      case 'job_kill': return { result: ctx.jobs.kill(command.jobId, handle.agent.session.id, 'Netcatty task stop') };
+      case 'job_read': return ctx.jobs.readAt(command.jobId, 0, handle.agent.session.id);
+      case 'shutdown':
+        await stop();
+        await handle?.dispose();
+        setImmediate(() => { void ctx.root.fiber.dispose().then(() => process.exit(0)); });
+        return {};
+      default: throw new Error(`Unsupported Netcatty bridge command: ${command.type}`);
+    }
+  };
+  const input = createInterface({ input: process.stdin, crlfDelay: Infinity });
+  input.on('line', (line) => {
+    let command;
+    try { command = JSON.parse(line); } catch (error) { send({ type: 'fatal', error: error.message }); return; }
+    if (command.type === 'interaction_response') {
+      if (command.id.startsWith('continued:')) {
+        const callId = command.id.slice('continued:'.length);
+        if (!command.cancelled && continuedQuestions.has(callId)) {
+          try {
+            ctx.userQuestions.answer(handle.agent, callId, { answers: command.answers || [] });
+            continuedQuestions.delete(callId);
+            void settle();
+          } catch (error) { send({ type: 'notice', message: error.message }); return; }
+        }
+        send({ type: 'interaction-cleared', id: command.id });
+      } else pending.get(command.id)?.(command);
+      return;
+    }
+    void dispatch(command).then(
+      (data) => send({ type: 'response', id: command.id, success: true, data }),
+      (error) => send({ type: 'response', id: command.id, success: false, error: error.message }),
+    );
+  });
+  ctx.effect(() => () => input.close(), 'netcatty.input');
+  send({ type: 'ready', version: process.env.NETCATTY_DSH_VERSION, bridgeVersion: 1 });
+}
diff --git a/scripts/build-1183-patch.mjs b/scripts/build-1183-patch.mjs
new file mode 100644
index 0000000..41777ba
--- /dev/null
+++ b/scripts/build-1183-patch.mjs
@@ -0,0 +1,76 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import * as asar from '@electron/asar';
+
+// Reuse the official Windows runtime and dependencies. Only compiled renderer,
+// listed integration files and the patch marker are changed in app.asar.
+const [officialDir, outputDir] = process.argv.slice(2).map((value) => path.resolve(value));
+if (!officialDir || !outputDir) throw new Error('Usage: node scripts/build-1183-patch.mjs OFFICIAL_WINDOWS_DIR OUTPUT_DIR');
+const root = process.cwd();
+const baseAsar = path.join(officialDir, 'resources/app.asar');
+const original = JSON.parse(asar.extractFile(baseAsar, 'package.json'));
+if (original.name !== 'netcatty' || original.version !== '1.1.83') throw new Error('Official Netcatty 1.1.83 is required');
+const changes = JSON.parse(await fs.readFile('scripts/patch1183-files.json', 'utf8'));
+const staging = path.join(outputDir, 'staging');
+await fs.rm(staging, { recursive: true, force: true });
+await fs.mkdir(staging, { recursive: true });
+asar.extractAll(baseAsar, staging);
+await fs.rm(path.join(staging, 'dist'), { recursive: true, force: true });
+await fs.cp(path.join(root, 'dist'), path.join(staging, 'dist'), { recursive: true });
+for (const file of changes) {
+  await fs.mkdir(path.dirname(path.join(staging, file)), { recursive: true });
+  await fs.copyFile(path.join(root, file), path.join(staging, file));
+}
+original.netcattyPatch = 'C1-1183-20261007';
+await fs.writeFile(path.join(staging, 'package.json'), JSON.stringify(original, null, 2) + '\n');
+const unpacked = [];
+function visit(node, prefix = '', inherited = false) {
+  if (node.files) for (const [name, child] of Object.entries(node.files)) visit(child, prefix ? `${prefix}/${name}` : name, inherited || node.unpacked);
+  else if (inherited || node.unpacked) unpacked.push(prefix);
+}
+const header = asar.getRawHeader(baseAsar).header;
+visit(header);
+const unpackPatterns = [];
+function counts(node, inherited = false) {
+  if (!node.files) return [1, inherited || node.unpacked ? 1 : 0];
+  return Object.values(node.files).map((child) => counts(child, inherited || node.unpacked)).reduce((a, b) => [a[0] + b[0], a[1] + b[1]], [0, 0]);
+}
+function group(node, prefix = '', inherited = false) {
+  const [total, selected] = counts(node, inherited);
+  if (!selected) return;
+  if (prefix && total === selected) { unpackPatterns.push(node.files ? `${prefix}/**/*` : prefix); return; }
+  for (const [name, child] of Object.entries(node.files)) group(child, prefix ? `${prefix}/${name}` : name, inherited || node.unpacked);
+}
+group(header);
+// Globstars omit dotfiles; keep the official unpacked layout for these too.
+unpackPatterns.push(...unpacked.filter((file) => file.split('/').some((part) => part.startsWith('.'))));
+unpacked.push('electron/bridges/aiBridge/sdk/nativeExtensions/controlled.mjs', 'packages/netcatty-dsh-bridge/bridge.mjs');
+unpackPatterns.push(...unpacked.slice(-2));
+const targetAsar = path.join(outputDir, 'payload/resources/app.asar');
+await fs.mkdir(path.dirname(targetAsar), { recursive: true });
+await asar.createPackageWithOptions(staging, targetAsar, { unpack: `{${unpackPatterns.map((pattern) => `${staging}/${pattern}`).join(',')}}` });
+const hash = async (file) => createHash('sha256').update(await fs.readFile(file)).digest('hex');
+const files = [];
+for (const file of unpacked) {
+  const target = `${targetAsar}.unpacked/${file}`;
+  const previous = `${baseAsar}.unpacked/${file}`;
+  const same = await hash(previous).then(async (value) => value === await hash(target)).catch(() => false);
+  if (same) await fs.rm(target);
+  else {
+    const existed = await fs.stat(previous).catch(() => null);
+    if (existed && !changes.includes(file)) throw new Error(`Unexpected dependency change: ${file}`);
+    files.push({ path: `resources/app.asar.unpacked/${file}`, sha256: await hash(target), originalSha256: existed ? await hash(previous) : null });
+  }
+}
+files.push({ path: 'resources/app.asar', sha256: await hash(targetAsar), originalSha256: await hash(baseAsar) });
+const manifest = {
+  patch: 'C1-1183-20261007', version: '1.1.83', platform: 'win32-x64',
+  baseCommit: 'd7a0c8ed8d238dcf1c82d786da53037a1f1496b1',
+  baseRelease: 'https://github.com/binaricat/Netcatty/releases/tag/v1.1.83',
+  executableSha256: await hash(path.join(officialDir, 'Netcatty.exe')),
+  engines: { omp: '18.5.1', pi: '1.0.3', dsh: '0.2.0-rc.2' }, files,
+};
+await fs.writeFile(path.join(outputDir, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
+await fs.rm(staging, { recursive: true, force: true });
+console.log(JSON.stringify({ patch: manifest.patch, modifiedFiles: files.length, originalUnpackedFilesReused: unpacked.length - files.length + 1 }));
diff --git a/scripts/native-agents.electron.live.cjs b/scripts/native-agents.electron.live.cjs
new file mode 100644
index 0000000..bd0646d
--- /dev/null
+++ b/scripts/native-agents.electron.live.cjs
@@ -0,0 +1,115 @@
+"use strict";
+// Run against an isolated Netcatty Electron profile with --remote-debugging-port=9222.
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const os = require('node:os');
+const { createNativeModelService } = require('./native-model-service.cjs');
+
+async function connect(pagePattern) {
+  const pages = await (await fetch(`http://127.0.0.1:${process.env.NATIVE_ELECTRON_PORT || 9222}/json/list`)).json();
+  const page = pages.find((entry) => entry.type === 'page' && !entry.url.startsWith('devtools:') && (pagePattern ? entry.url.includes(pagePattern) : !entry.url.includes('#/settings')));
+  assert(page, 'Netcatty Electron window must be running');
+  const ws = new WebSocket(page.webSocketDebuggerUrl);
+  await new Promise((resolve) => ws.addEventListener('open', resolve, { once: true }));
+  const pending = new Map(); let id = 0;
+  ws.addEventListener('message', ({ data }) => {
+    const message = JSON.parse(data); const p = pending.get(message.id);
+    if (!p) return;
+    pending.delete(message.id);
+    if (message.error || message.result.exceptionDetails) p.reject(new Error(JSON.stringify(message.error || message.result.exceptionDetails)));
+    else p.resolve(message.result);
+  });
+  const request = (method, params) => new Promise((resolve, reject) => {
+      pending.set(++id, { resolve, reject });
+      ws.send(JSON.stringify({ id, method, params }));
+    });
+  return { request, evaluate: async (expression) => (await request('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true })).result?.value, close: () => ws.close() };
+}
+async function main() {
+  const root = process.env.NETCATTY_NATIVE_RUNTIME;
+  assert(root, 'Set NETCATTY_NATIVE_RUNTIME');
+  const entries = JSON.parse(await fs.readFile(path.join(root, 'engines.json'), 'utf8'));
+  const service = await createNativeModelService();
+  const cdp = await connect();
+  const scratch = await fs.mkdtemp(path.join(root, 'electron-smoke-'));
+  try {
+    console.log(await cdp.evaluate(`(async () => {
+      const api = window.netcatty;
+      for (const sessionId of ['native-smoke-a', 'native-smoke-b']) await api.startLocalSession({ sessionId, shell: ${JSON.stringify(process.platform === 'win32' ? 'powershell.exe' : '/bin/bash')}, cwd: ${JSON.stringify(process.cwd())}, cols: 100, rows: 30 });
+      await api.aiMcpSetPermissionMode('confirm');
+      await api.aiMcpUpdateLiveSessions(['a','b'].map(x => ({ sessionId: 'native-smoke-' + x, hostname: 'local-' + x, label: 'Native smoke ' + x, protocol: 'local', shellType: 'bash', connected: true })));
+      return { title: document.title, localPty: true };
+    })()`));
+    for (const engine of (process.env.NATIVE_ENGINES || 'dsh,pi,omp').split(',')) {
+      const dir = path.join(scratch, engine); await fs.mkdir(dir);
+      const models = { providers: { local: { api: 'openai-completions', baseUrl: `${service.url}/v1`, apiKey: 'local-test-key', models: [{ id: 'netcatty-smoke', reasoning: false, input: ['text'], contextWindow: 64000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }] } } };
+      await fs.writeFile(path.join(dir, 'models.json'), JSON.stringify(models));
+      await fs.writeFile(path.join(dir, 'models.yml'), JSON.stringify(models));
+      const config = { engine, cwd: scratch, bin: entries[engine], model: engine === 'dsh' ? 'deepseek-official/deepseek-flash' : 'local/netcatty-smoke', env: { PI_CONFIG_DIR: path.relative(os.homedir(), path.join(dir, 'omp-config')), PI_CODING_AGENT_DIR: dir, DSH_TELEMETRY_DISABLED: '1', DSH_HOME: path.join(dir, 'dsh'), DEEPSEEK_API_KEY: 'local-test-key', DEEPSEEK_BASE_URL: service.url, NETCATTY_NATIVE_LOCAL_TOOLS: 'disabled' } };
+      const result = await cdp.evaluate(`(async (config) => {
+        const api = window.netcatty; const chat = 'native-electron-' + config.engine;
+        const events = []; let allow = false; let approvals = 0;
+        let approvalSeen;
+        await api.aiMcpUpdateSessions([{sessionId:'native-smoke-a',hostname:'local-a',label:'Native smoke a',protocol:'local',shellType:'bash',connected:true}], chat);
+        const offApproval = api.onMcpApprovalRequest((request) => {
+          if (request.chatSessionId !== chat) return;
+          approvals++;
+          if (approvalSeen) approvalSeen(request);
+          else api.respondMcpApproval(request.approvalId, allow, 'once');
+        });
+        const offNative = api.onAiNativeSessionEvent(chat, (snapshot) => {
+          for (const item of snapshot.interactions) api.aiNativeSessionControl({chatSessionId:chat,instanceId:snapshot.instanceId,action:'respond',id:item.id,answer:item.questions?{answers:item.questions.map(q=>({id:q.id,selected:['Alpha']}))}:{value:'Extension reply'}});
+        });
+        let resume;
+        const run = async (prompt) => {
+          const requestId = crypto.randomUUID();
+          const off = api.onAiSdkAgentEvent(requestId, (event) => { events.push(event); if(event.type==='session-id') resume=event.sessionId; });
+          const offError = api.onAiSdkAgentError(requestId, (error) => events.push({type:'fatal',error}));
+          try { const result = await api.aiSdkAgentStream(requestId, chat, config.engine, prompt, config.cwd, undefined, config.model, resume, [], undefined, 'mcp', undefined, undefined, config.env, config.bin, undefined, 'confirm'); if (!result.ok) throw Error(JSON.stringify(result)); }
+          finally { off(); offError(); }
+        };
+        try {
+          await run('NC_ECHO first persisted Electron turn');
+          if(!resume) throw Error('Missing native resume identity');
+          await api.aiSdkAgentCleanup(chat);
+          await api.aiMcpUpdateSessions([{sessionId:'native-smoke-a',hostname:'local-a',label:'Native smoke a',protocol:'local',shellType:'bash',connected:true}], chat);
+          await run('NC_ECHO resumed Electron turn');
+          await run(config.engine==='dsh'?'NC_QUESTION ordinary question':'/netcatty-check');
+          await run('NC_REMOTE inspect the scoped connected terminals');
+          const environment = events.filter(event => event.type === 'tool-result');
+          if (!JSON.stringify(environment).includes('local-a') || JSON.stringify(environment).includes('local-b')) throw Error('MCP scope failed: ' + JSON.stringify(events));
+          await run('NC_EXEC denied terminal command');
+          const denied = events.filter(event => event.type === 'tool-result').at(-1);
+          if (JSON.stringify(denied).includes('NETCATTY_MCP_CLI_OK')) throw Error('Denied command executed');
+          allow = true;
+          await run('NC_EXEC approved terminal command');
+          const executed = events.filter(event => event.type === 'tool-result').at(-1);
+          if (!JSON.stringify(executed).includes('NETCATTY_MCP_CLI_OK')) throw Error('Terminal command did not execute: ' + JSON.stringify(executed));
+          if (approvals < 2) throw Error('Missing approvals');
+          const beforeStop = events.length;
+          const waiting = new Promise(resolve => { approvalSeen = resolve; });
+          const pendingTurn = run('NC_EXEC cancel while waiting for approval');
+          const pendingRequest = await waiting;
+          await api.aiSdkAgentCancel('', chat);
+          await api.respondMcpApproval(pendingRequest.approvalId, true, 'once');
+          await pendingTurn;
+          if (events.slice(beforeStop).some(event => event.type === 'tool-result' && JSON.stringify(event.output).includes('NETCATTY_MCP_CLI_OK'))) throw Error('Late approval executed after stop');
+          return { engine: config.engine, realCliResume: true, nativeInteraction: true, scopedMcp: true, approvalAndDenial: true, localPtyExecution: true, stopPendingApproval: true, events: events.length };
+        } finally { offNative(); offApproval(); await api.aiSdkAgentCleanup(chat); }
+      })(${JSON.stringify(config)})`);
+      console.log(JSON.stringify(result));
+      assert(JSON.stringify(service.requests.at(-1)).includes('first persisted Electron turn'), `${engine}: persisted history missing`);
+    }
+  } finally {
+    await fs.writeFile(path.join(scratch, 'model-requests.json'), JSON.stringify(service.requests, null, 2));
+    await cdp.evaluate(`Promise.all(['native-smoke-a','native-smoke-b'].map(id=>window.netcatty.closeSession(id)))`).catch(() => {});
+    cdp.close(); await service.close();
+  }
+  console.log(`Real Electron + CLIs + Netcatty MCP + local PTY; local controlled model only. ${scratch}`);
+}
+if (require.main === module) {
+  const timer = setTimeout(() => { console.error('Electron native smoke timed out'); process.exit(1); }, 180000);
+  main().then(() => clearTimeout(timer), (error) => { clearTimeout(timer); console.error(error); process.exitCode = 1; });
+}
+module.exports = { connect };
diff --git a/scripts/native-agents.live.cjs b/scripts/native-agents.live.cjs
new file mode 100644
index 0000000..b443469
--- /dev/null
+++ b/scripts/native-agents.live.cjs
@@ -0,0 +1,135 @@
+"use strict";
+// Opt in: NETCATTY_NATIVE_RUNTIME=/path/to/installed/resources node scripts/native-agents.live.cjs
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const os = require('node:os');
+const { createNativeModelService } = require('./native-model-service.cjs');
+const { nativeSessionManager } = require('../electron/bridges/aiBridge/sdk/nativeSessionManager.cjs');
+const { createStreamEmitter } = require('../electron/bridges/aiBridge/sdk/emit.cjs');
+
+async function main() {
+  const root = process.env.NETCATTY_NATIVE_RUNTIME;
+  assert(root, 'Set NETCATTY_NATIVE_RUNTIME to the directory containing bin/omp and runtime/node_modules/.bin/{pi,dsh}');
+  const scratch = await fs.mkdtemp(path.join(root, 'smoke-'));
+  const entries = JSON.parse(await fs.readFile(path.join(root, 'engines.json'), 'utf8'));
+  await fs.mkdir(path.join(scratch, 'tmp'));
+  let held;
+  const service = await createNativeModelService((body) => { if (JSON.stringify(body.messages.at(-1)).includes('NC_HOLD')) held?.(); });
+  try {
+    for (const engine of (process.env.NATIVE_ENGINES || 'dsh,pi,omp').split(',')) {
+      const driver = require(`../electron/bridges/aiBridge/sdk/${engine === 'dsh' ? 'dshNative' : engine + 'Rpc'}Driver.cjs`);
+      const dir = path.join(scratch, engine);
+      await fs.mkdir(dir);
+      const models = { providers: { 'netcatty-local': { baseUrl: `${service.url}/v1`, api: 'openai-completions', apiKey: 'local-test-key', models: [{ id: 'netcatty-smoke', name: 'Local controlled test', reasoning: false, input: ['text'], contextWindow: 64000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }] } } };
+      await fs.writeFile(path.join(dir, 'models.json'), JSON.stringify(models));
+      await fs.writeFile(path.join(dir, 'models.yml'), JSON.stringify(models));
+      let approvals = 0;
+      let allow = true;
+      const events = [];
+      const snapshots = [];
+      const answered = new Set();
+      let autoAnswer = true;
+      let onSnapshot;
+      const base = {
+        chatSessionId: `smoke-${engine}`, requestId: 'smoke', cwd: scratch,
+        binPath: entries[engine],
+        model: engine === 'dsh' ? 'deepseek-official/deepseek-flash' : 'netcatty-local/netcatty-smoke',
+        env: { ...process.env, PI_CONFIG_DIR: path.relative(os.homedir(), path.join(dir, 'omp-config')), PI_CODING_AGENT_DIR: dir, DSH_PERMISSION_MODE: 'danger-full-access', DSH_TELEMETRY_DISABLED: '1', DSH_HOME: path.join(dir, 'dsh'), DEEPSEEK_API_KEY: 'local-test-key', DEEPSEEK_BASE_URL: service.url, NETCATTY_NATIVE_LOCAL_TOOLS: 'confirm' },
+        toolIntegrationMode: 'mcp', injectedMcpServers: [], permissionMode: 'confirm',
+        getTempDir: () => path.join(scratch, 'tmp'),
+        requestApprovalFromRenderer: async () => { approvals++; return allow; },
+        clearPendingApprovals: () => {},
+        emitNativeSession: (snapshot) => {
+          snapshots.push(snapshot); onSnapshot?.(snapshot);
+          if (!autoAnswer) return;
+          for (const item of snapshot.interactions) {
+            if (answered.has(item.id)) continue;
+            answered.add(item.id);
+            const answer = item.questions ? { answers: item.questions.map((q) => ({ id: q.id, selected: [q.intent?.approve || 'Alpha'] })) } : { value: 'Extension reply' };
+            setImmediate(() => nativeSessionManager.get(base.chatSessionId)?.respond(item.id, answer));
+          }
+        },
+      };
+      const run = async (prompt, extra = {}) => {
+        const emitter = createStreamEmitter({ requestId: 'smoke', safeSend: (_sender, channel, payload) => events.push({ channel, ...payload }) });
+        return driver.runTurn({ ...base, prompt, emitter, ...extra });
+      };
+      const result = await run('NC_ECHO first native turn');
+      assert(events.some((entry) => entry.event?.textDelta?.includes('LOCAL_MODEL_OK')), `${engine}: missing streamed text`);
+      await nativeSessionManager.closeForChat(base.chatSessionId);
+      await run('NC_ECHO resumed second turn', { resumeSessionId: result.sessionId });
+      assert(JSON.stringify(service.requests.at(-1)).includes('first native turn'), `${engine}: history did not resume`);
+      await run('NC_TOOL approved local command');
+      await fs.writeFile(path.join(scratch, `${engine}-events.json`), JSON.stringify(events, null, 2));
+      assert(events.some((entry) => entry.event?.type === 'tool-result' && JSON.stringify(entry.event.output).includes('NATIVE_LOCAL_OK')), `${engine}: approved local command did not execute`);
+      assert(approvals > 0, `${engine}: local tool bypassed approval`);
+      assert(events.some((entry) => entry.event?.type === 'tool-result'), `${engine}: missing tool events`);
+      if (engine !== 'dsh') {
+        await run('/netcatty-check');
+        assert(snapshots.some((snapshot) => snapshot.widgets.some((widget) => widget.text.includes('Extension reply'))), `${engine}: extension answer was lost`);
+        if (engine === 'omp' && process.env.NATIVE_EXTENDED === '1') {
+          let cancelled = false;
+          onSnapshot = (snapshot) => {
+            const task = snapshot.tasks.find((task) => task.status === 'started');
+            if (!task || cancelled) return;
+            cancelled = true;
+            void nativeSessionManager.get(base.chatSessionId).rpc.request('cancel_subagent', { subagentId: task.id });
+          };
+          await run('NC_TASK start a subagent');
+          onSnapshot = undefined;
+          assert(cancelled, 'OMP subagent was not presented or cancelled');
+        }
+      } else {
+        await run('NC_QUESTION ordinary question');
+        assert(answered.size, 'DSH question was not presented');
+        if (process.env.NATIVE_EXTENDED === '1') {
+        await nativeSessionManager.get(base.chatSessionId).rpc.request('plan_mode', { active: true });
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.active, true, 'DSH plan mode must be visible');
+        await run('NC_PLAN review the plan');
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.active, false, 'DSH reviewed plan must leave plan mode');
+        assert.equal(nativeSessionManager.get(base.chatSessionId).plan.pending, undefined, 'Committed plan mode must clear the pending indicator');
+        assert(snapshots.some((snapshot) => snapshot.interactions.some((item) => item.questions?.some((q) => q.intent?.kind === 'plan-review'))), 'DSH plan review missing');
+        let killed = false;
+        onSnapshot = (snapshot) => {
+          const job = snapshot.tasks.find((task) => task.status === 'running');
+          if (!job || killed) return;
+          killed = true;
+          void nativeSessionManager.get(base.chatSessionId).rpc.request('job_kill', { jobId: job.id });
+        };
+        await run('NC_JOB start a background command');
+        onSnapshot = undefined;
+        assert(killed, 'DSH background task was not exposed');
+        assert(snapshots.some((snapshot) => snapshot.tasks.some((task) => task.status === 'killed')), 'DSH background task was not killed');
+        autoAnswer = false;
+        await run('NC_QUESTION deferred answer');
+        const session = nativeSessionManager.get(base.chatSessionId);
+        const pending = [...session.interactions.values()].find((item) => item.id.startsWith('continued:'));
+        assert(pending, 'DSH timed question disappeared instead of continuing');
+        const continued = new Promise((resolve) => { onSnapshot = (snapshot) => { if (snapshot.widgets.some((widget) => widget.id === 'continuation' && widget.text.includes('LOCAL_MODEL_OK'))) resolve(); }; });
+        session.respond(pending.id, { answers: [{ id: 'choice', selected: ['Alpha'] }] });
+        await continued;
+        onSnapshot = undefined; autoAnswer = true;
+        }
+      }
+      allow = false;
+      const approvalCount = approvals;
+      await run('NC_TOOL denied local command');
+      assert(approvals > approvalCount, `${engine}: denial was not requested`);
+      const abort = new AbortController();
+      const requestSeen = new Promise((resolve) => { held = resolve; });
+      const turn = run('NC_HOLD interrupt this request', { signal: abort.signal });
+      await requestSeen;
+      abort.abort();
+      await turn;
+      assert(!nativeSessionManager.get(base.chatSessionId), `${engine}: stopped process still registered`);
+      console.log(`${engine}: real CLI stream, tools/approval, denial, native resume, interactions${process.env.NATIVE_EXTENDED === '1' ? '/extended' : ''} and stop PASS`);
+    }
+  } finally {
+    await fs.writeFile(path.join(scratch, 'model-requests.json'), JSON.stringify(service.requests, null, 2));
+    await nativeSessionManager.closeAll(); await service.close();
+  }
+  console.log(`Local controlled model only; artifacts: ${scratch}`);
+}
+const deadline = setTimeout(() => { console.error('Native smoke timed out'); void nativeSessionManager.closeAll().finally(() => process.exit(1)); }, 180000);
+main().then(() => clearTimeout(deadline), (error) => { clearTimeout(deadline); console.error(error); process.exitCode = 1; });
