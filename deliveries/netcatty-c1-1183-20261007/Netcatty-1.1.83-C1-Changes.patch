+// Deliberately limited to the native RPC UI contract supported by Netcatty.
+export default function netcattyExtension(pi) {
+  const config = JSON.parse(process.env.NETCATTY_NATIVE_CONFIG || '{}');
+  if (config.engine === 'pi') {
+    for (const server of config.mcpServers || []) {
+      pi.registerMcpServer(server.name, {
+        command: server.command, args: server.args,
+        env: Object.fromEntries(server.env.map(({ name, value }) => [name, value])),
+        exposure: 'direct', timeout: 300000,
+      });
+    }
+  }
+  pi.on('tool_call', async (event, ctx) => {
+    const remote = config.engine === 'omp'
+      ? event.toolName.startsWith('netcatty__')
+      : (config.mcpServers || []).some((server) => event.toolName.startsWith(`mcp__${server.name}__`));
+    if (remote || (config.engine === 'omp' && ['ask', 'todo', 'wait'].includes(event.toolName))) return;
+    if (config.localTools !== 'confirm' || config.permissionMode === 'observer') {
+      return { block: true, reason: 'Local tools are disabled. Use Netcatty MCP for connected terminals.' };
+    }
+    const approved = await ctx.ui.confirm('Netcatty local tool', JSON.stringify({ tool: event.toolName, args: event.input, cwd: ctx.cwd }));
+    if (!approved || ctx.signal?.aborted) return { block: true, reason: 'Local tool denied or cancelled.' };
+  });
+  pi.registerCommand('netcatty-check', {
+    description: 'Check the Netcatty extension interaction',
+    handler: async (_args, ctx) => {
+      const value = await ctx.ui.input('Netcatty extension check', 'Enter a short message');
+      ctx.ui.setWidget('netcatty-check', [value === undefined ? 'Cancelled' : `Received: ${value}`]);
+    },
+  });
+}
diff --git a/electron/bridges/aiBridge/sdk/nativeRpcConnection.cjs b/electron/bridges/aiBridge/sdk/nativeRpcConnection.cjs
new file mode 100644
index 0000000..9da1315
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/nativeRpcConnection.cjs
@@ -0,0 +1,156 @@
+"use strict";
+const { spawn } = require('node:child_process');
+const { EventEmitter } = require('node:events');
+const { StringDecoder } = require('node:string_decoder');
+const { prepareNativeCommand } = require('./nativeCli.cjs');
+const { processTree } = require('../../ptyProcessTree.cjs');
+
+// OMP v2 alone uses chunked frames. Pi and the DSH bridge stay plain JSONL.
+class OmpFrameDecoder {
+  decode(frame) {
+    if (frame.type !== 'rpc_chunk') {
+      if (this.chunk) throw new Error('Interrupted OMP chunk sequence');
+      return frame;
+    }
+    if (!this.chunk) {
+      if (frame.index !== 0 || !Number.isInteger(frame.count) || frame.count < 1 ||
+          !Number.isInteger(frame.byteLength) || frame.byteLength < 1 || frame.byteLength > 67108864) {
+        throw new Error('Invalid OMP chunk header');
+      }
+      this.chunk = { id: frame.chunkId, count: frame.count, length: frame.byteLength, parts: [], bytes: 0 };
+    }
+    const chunk = this.chunk;
+    if (frame.chunkId !== chunk.id || frame.count !== chunk.count || frame.byteLength !== chunk.length || frame.index !== chunk.parts.length) {
+      throw new Error('Invalid OMP chunk sequence');
+    }
+    const bytes = Buffer.from(frame.data, 'base64');
+    chunk.bytes += bytes.length;
+    if (chunk.bytes > chunk.length) throw new Error('OMP chunk exceeded announced size');
+    chunk.parts.push(bytes);
+    if (chunk.parts.length !== chunk.count) return null;
+    this.chunk = null;
+    if (chunk.bytes !== chunk.length) throw new Error('Incomplete OMP frame');
+    return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.concat(chunk.parts)));
+  }
+}
+
+class NativeRpcConnection extends EventEmitter {
+  constructor({ command, args, env, cwd, engine }) {
+    super();
+    this.pending = new Map();
+    this.seq = 0;
+    this.stderr = '';
+    this.engine = engine;
+    this.decoder = engine === 'omp' ? new OmpFrameDecoder() : null;
+    const spec = prepareNativeCommand(command, args, env);
+    this.child = spawn(spec.command, spec.args, {
+      cwd, env, shell: spec.shell, windowsHide: true,
+      detached: process.platform !== 'win32', stdio: ['pipe', 'pipe', 'pipe'],
+    });
+    this.closed = new Promise((resolve) => this.child.once('close', resolve));
+    this.child.once('error', (error) => this.fail(error));
+    this.child.once('exit', (code, signal) => this.fail(new Error(`${engine} exited (${code ?? signal}). ${this.stderr}`)));
+    this.child.stdin.on('error', (error) => this.fail(error));
+    this.child.stderr.setEncoding('utf8');
+    this.child.stderr.on('data', (data) => {
+      // Keep diagnostics bounded and redact credentials before exposing errors.
+      for (const [key, value] of Object.entries(env || {})) {
+        if (/KEY|TOKEN|SECRET|PASSWORD/i.test(key) && value?.length > 3) data = data.split(value).join('[redacted]');
+      }
+      this.stderr = (this.stderr + data).slice(-6000);
+    });
+    const utf8 = new StringDecoder('utf8');
+    let buffer = '';
+    this.child.stdout.on('data', (bytes) => {
+      buffer += utf8.write(bytes);
+      try {
+        let end;
+        while ((end = buffer.indexOf('\n')) >= 0) {
+          const line = buffer.slice(0, end).replace(/\r$/, '');
+          buffer = buffer.slice(end + 1);
+          if (!line) continue;
+          if (Buffer.byteLength(line) > 67108864) throw new Error('Native RPC frame too large');
+          const parsed = JSON.parse(line);
+          const frame = this.decoder ? this.decoder.decode(parsed) : parsed;
+          if (!frame) continue;
+          if (frame.type === 'ready') { this.ready = frame; this.emit('ready', frame); }
+          if (frame.type === 'response' && this.pending.has(frame.id)) {
+            const pending = this.pending.get(frame.id);
+            this.pending.delete(frame.id);
+            clearTimeout(pending.timer);
+            if (frame.success === false) pending.reject(new Error(frame.error));
+            else pending.resolve(frame.data);
+          } else this.emit('frame', frame);
+        }
+        if (Buffer.byteLength(buffer) > 67108864) throw new Error('Native RPC line too large');
+      } catch (error) { this.fail(new Error(`${engine} protocol: ${error.message}`)); }
+    });
+  }
+  fail(error) {
+    if (this.failure) return;
+    this.failure = error;
+    for (const pending of this.pending.values()) { clearTimeout(pending.timer); pending.reject(error); }
+    this.pending.clear();
+    this.emit('fatal', error);
+  }
+  send(frame) {
+    if (this.failure) throw this.failure;
+    this.child.stdin.write(`${JSON.stringify(frame)}\n`);
+  }
+  request(type, data = {}, timeoutMs = 30000) {
+    if (this.failure) return Promise.reject(this.failure);
+    const id = `nc-${++this.seq}`;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { this.pending.delete(id); reject(new Error(`${this.engine}: ${type} timed out`)); }, timeoutMs);
+      this.pending.set(id, { resolve, reject, timer });
+      try { this.send({ ...data, id, type }); } catch (error) { clearTimeout(timer); this.pending.delete(id); reject(error); }
+    });
+  }
+  waitReady() {
+    if (this.ready) return Promise.resolve(this.ready);
+    if (this.failure) return Promise.reject(this.failure);
+    return new Promise((resolve, reject) => {
+      const done = (error, value) => { clearTimeout(timer); this.off('ready', ready); this.off('fatal', fatal); error ? reject(error) : resolve(value); };
+      const ready = (value) => done(null, value);
+      const fatal = (error) => done(error);
+      const timer = setTimeout(() => done(new Error(`${this.engine} did not become ready. ${this.stderr}`)), 30000);
+      this.once('ready', ready); this.once('fatal', fatal);
+    });
+  }
+  async close() {
+    if (this.closePromise) return this.closePromise;
+    this.closePromise = (async () => {
+      // Capture Windows descendants before a cooperative CLI can exit/reparent them.
+      const descendants = [];
+      if (process.platform === 'win32' && this.child.pid) {
+        const collect = async (pid) => {
+          const key = `native-${pid}`;
+          processTree.registerPid(key, pid);
+          const children = await processTree.getChildProcesses(key);
+          processTree.unregisterPid(key);
+          for (const child of children) { descendants.push(child.pid); await collect(child.pid); }
+        };
+        await collect(this.child.pid);
+      }
+      if (!this.failure) await this.request(this.engine === 'dsh' ? 'shutdown' : 'abort', {}, 1500).catch(() => {});
+      this.child.stdin.end();
+      const kill = () => {
+        if (!this.child.pid) return;
+        if (process.platform === 'win32') {
+          for (const pid of [this.child.pid, ...descendants]) {
+            const killer = spawn('taskkill', ['/pid', String(pid), '/T', '/F'], { windowsHide: true, stdio: 'ignore' });
+            killer.on('error', () => {});
+          }
+        }
+        else { try { process.kill(-this.child.pid, 'SIGKILL'); } catch { /* already exited */ } }
+      };
+      const timer = setTimeout(kill, 1500);
+      await this.closed;
+      clearTimeout(timer);
+      // Also reap descendants if a CLI exited before its MCP/shell children.
+      kill();
+    })();
+    return this.closePromise;
+  }
+}
+module.exports = { NativeRpcConnection, OmpFrameDecoder };
diff --git a/electron/bridges/aiBridge/sdk/nativeRpcConnection.test.cjs b/electron/bridges/aiBridge/sdk/nativeRpcConnection.test.cjs
new file mode 100644
index 0000000..ee58f59
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/nativeRpcConnection.test.cjs
@@ -0,0 +1,17 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { OmpFrameDecoder } = require('./nativeRpcConnection.cjs');
+
+test('OMP v2 joins byte chunks before decoding UTF-8 and preserves Unicode line separators', () => {
+  const value = { type: 'message_update', text: '\u4e2d\u6587\u2028next' };
+  const bytes = Buffer.from(JSON.stringify(value));
+  const cut = bytes.indexOf(Buffer.from('\u4e2d')) + 1;
+  const chunks = [bytes.subarray(0, cut), bytes.subarray(cut)];
+  const decoder = new OmpFrameDecoder();
+  const frames = chunks.map((chunk, index) => ({ type: 'rpc_chunk', chunkId: 'one', index, count: 2, byteLength: bytes.length, data: chunk.toString('base64') }));
+  assert.equal(decoder.decode(frames[0]), null);
+  assert.deepEqual(decoder.decode(frames[1]), value);
+  const broken = new OmpFrameDecoder();
+  broken.decode(frames[0]);
+  assert.throws(() => broken.decode({ ...frames[1], index: 0 }), /sequence/);
+});
diff --git a/electron/bridges/aiBridge/sdk/nativeSessionManager.cjs b/electron/bridges/aiBridge/sdk/nativeSessionManager.cjs
new file mode 100644
index 0000000..540a315
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/nativeSessionManager.cjs
@@ -0,0 +1,221 @@
+"use strict";
+const path = require('node:path');
+const fs = require('node:fs/promises');
+const { randomUUID, createHash } = require('node:crypto');
+const { execFile } = require('node:child_process');
+const { NativeRpcConnection } = require('./nativeRpcConnection.cjs');
+const { nativeEntry, prepareNativeCommand } = require('./nativeCli.cjs');
+
+const sessions = new Map();
+const VERSIONS = { omp: '18.5.1', pi: '1.0.3', dsh: '0.2.0-rc.2' };
+function fingerprint(ctx) {
+  return createHash('sha256').update(JSON.stringify([ctx.binPath, ctx.cwd, ctx.model, ctx.env, ctx.permissionMode])).digest('hex');
+}
+function versionOf(command, env) {
+  const spec = prepareNativeCommand(command, ['--version'], env);
+  return new Promise((resolve, reject) => execFile(spec.command, spec.args, {
+    env, shell: spec.shell, windowsHide: true, timeout: 15000,
+  }, (error, stdout) => error ? reject(error) : resolve(stdout.trim())));
+}
+function resourcePath(...parts) {
+  return path.join(__dirname.replace(/app\.asar([/\\])/, 'app.asar.unpacked$1'), ...parts);
+}
+function decodeResume(value, engine, ctx) {
+  if (!value) return undefined;
+  const identity = JSON.parse(value);
+  if (identity.v !== 1 || identity.engine !== engine || identity.cwd !== path.resolve(ctx.cwd)) {
+    throw new Error('Native session runtime or workspace changed. Start a new chat to use this configuration.');
+  }
+  return identity.id;
+}
+
+class NativeSession {
+  constructor(engine, implementation, ctx) {
+    this.engine = engine;
+    this.implementation = implementation;
+    this.ctx = ctx;
+    this.key = fingerprint(ctx);
+    this.instanceId = randomUUID();
+    this.interactions = new Map();
+    this.tasks = new Map();
+    this.widgets = new Map();
+    this.status = 'starting';
+    this.seq = 0;
+    this.disposers = [];
+    if (ctx.sender?.once) {
+      const destroyed = () => { void this.stop(); };
+      ctx.sender.once('destroyed', destroyed);
+      this.disposers.push(() => ctx.sender.removeListener('destroyed', destroyed));
+    }
+  }
+  publish() {
+    this.ctx.emitNativeSession?.(this.snapshot());
+  }
+  snapshot() {
+    return {
+      chatSessionId: this.ctx.chatSessionId, engine: this.engine, instanceId: this.instanceId,
+      seq: ++this.seq, version: this.version, status: this.status,
+      plan: this.plan,
+      interactions: [...this.interactions.values()], tasks: [...this.tasks.values()], widgets: [...this.widgets.values()],
+    };
+  }
+  emit(method, ...args) {
+    if (this.turn) this.turn.emitter[method]?.(...args);
+    else if (method === 'text') {
+      const previous = this.widgets.get('continuation')?.text || '';
+      this.widgets.set('continuation', { id: 'continuation', text: previous + args[0] });
+      this.publish();
+    }
+  }
+  setNativeId(id) {
+    this.nativeId = id;
+    this.identity = JSON.stringify({ v: 1, engine: this.engine, version: this.version, cwd: path.resolve(this.ctx.cwd), id });
+    this.emit('sessionId', this.identity);
+  }
+  async start() {
+    this.entry = nativeEntry(this.ctx.binPath, this.engine);
+    this.version = await versionOf(this.entry, this.ctx.env);
+    this.resume = decodeResume(this.ctx.resumeSessionId, this.engine, this.ctx);
+    if (this.ctx.signal?.aborted || this.closing) throw new Error("Native startup cancelled");
+    const spec = await this.implementation.launch(this);
+    if (this.ctx.signal?.aborted || this.closing) throw new Error("Native startup cancelled");
+    this.rpc = new NativeRpcConnection({ command: this.entry, ...spec, engine: this.engine, cwd: this.ctx.cwd });
+    this.rpc.on('fatal', (error) => {
+      if (this.closing) return;
+      this.status = 'error'; this.widgets.set('error', { id: 'error', text: error.message }); this.publish();
+      this.finish(error);
+      void this.close();
+    });
+    this.rpc.on('frame', (frame) => {
+      try {
+        if (frame.type === 'extension_ui_request' || frame.type === 'interaction') {
+          void this.handleUi(frame).catch((error) => { this.finish(error); void this.close(); }); return;
+        }
+        if (frame.type === 'interaction-cleared') { this.interactions.delete(frame.id); this.publish(); return; }
+        this.implementation.frame(this, frame);
+      } catch (error) { this.finish(error); }
+    });
+    await this.implementation.open(this);
+    this.status = 'idle'; this.publish();
+  }
+  async handleUi(frame) {
+    const method = frame.method || frame.kind;
+    if (method === 'cancel') { this.interactions.delete(frame.targetId); this.publish(); return; }
+    if (['notify', 'setStatus', 'setWidget', 'setTitle', 'set_editor_text'].includes(method)) {
+      const id = frame.widgetKey || frame.statusKey || method;
+      const text = frame.widgetLines?.join('\n') || frame.statusText || frame.message || frame.title || frame.text || '';
+      if (text) this.widgets.set(id, { id, text }); else this.widgets.delete(id);
+      this.publish(); return;
+    }
+    if (method === 'approval' || (method === 'confirm' && frame.title === 'Netcatty local tool')) {
+      const ctx = this.ctx;
+      const approved = ctx.permissionMode !== 'observer' && await ctx.requestApprovalFromRenderer?.(
+        `${this.engine.toUpperCase()} local workspace: ${frame.toolName || 'tool'}`,
+        { cwd: ctx.cwd, ...frame.args, details: frame.reason || frame.message, executionScope: 'local-workspace' }, ctx.chatSessionId, { allowSession: false },
+      );
+      if (!this.closing && !ctx.signal?.aborted) {
+        this.rpc.send(this.engine === 'dsh'
+          ? { type: 'interaction_response', id: frame.id, approved: Boolean(approved) }
+          : { type: 'extension_ui_response', id: frame.id, confirmed: Boolean(approved) });
+      }
+      return;
+    }
+    this.interactions.set(frame.id, { ...frame, method });
+    this.publish();
+    if (frame.timeout) {
+      const timer = setTimeout(() => { this.interactions.delete(frame.id); this.publish(); }, frame.timeout);
+      this.disposers.push(() => clearTimeout(timer));
+    }
+  }
+  respond(id, answer) {
+    if (!this.interactions.has(id)) return false;
+    this.interactions.delete(id);
+    this.rpc.send({ ...answer, id, type: this.engine === 'dsh' ? 'interaction_response' : 'extension_ui_response' });
+    this.publish(); return true;
+  }
+  finish(error) {
+    if (!this.turn || (this.closing && this.status !== 'closed')) return;
+    const turn = this.turn; this.turn = null;
+    this.status = this.closing ? 'closed' : error ? 'error' : 'idle'; this.publish();
+    if (error) turn.reject(error);
+    else { turn.emitter.emitDone(); turn.resolve({ sessionId: this.identity }); }
+  }
+  async run(ctx) {
+    if (this.turn) throw new Error('A native turn is already running in this chat');
+    this.ctx = ctx;
+    this.status = 'running';
+    const result = new Promise((resolve, reject) => { this.turn = { id: randomUUID(), resolve, reject, emitter: ctx.emitter }; });
+    void result.catch(() => {}); // Startup failures may arrive before prompt admission returns.
+    const abort = () => { void this.stop(); };
+    ctx.signal?.addEventListener('abort', abort, { once: true });
+    try {
+      if (!this.rpc) await this.start();
+      if (ctx.signal?.aborted) { await this.stop(); return await result; }
+      this.emit('sessionId', this.identity);
+      this.status = 'running'; this.publish();
+      await this.implementation.prompt(this, ctx.prompt);
+    } catch (error) { this.finish(error); await this.close(); }
+    return result.finally(() => ctx.signal?.removeEventListener('abort', abort));
+  }
+  async stop() {
+    this.ctx.clearPendingApprovals?.(this.ctx.chatSessionId);
+    await this.close();
+    this.finish();
+  }
+  async close() {
+    if (this.closing) return this.closing;
+    this.closing = (async () => {
+      this.interactions.clear();
+      await this.rpc?.close();
+      for (const dispose of this.disposers.splice(0)) await dispose();
+      this.status = 'closed'; this.publish();
+      if (sessions.get(this.ctx.chatSessionId) === this) sessions.delete(this.ctx.chatSessionId);
+    })();
+    return this.closing;
+  }
+}
+
+function nativeDriver(engine, implementation) {
+  return {
+    async checkConnection(ctx, testModel = false) {
+      const session = new NativeSession(engine, implementation, ctx);
+      const abort = new AbortController();
+      const timer = setTimeout(() => abort.abort(), 60000);
+      let text = '';
+      try {
+        if (testModel) await session.run({ ...ctx, prompt: 'Reply with OK only. Do not use tools.', signal: abort.signal,
+          emitter: { text: (value) => { text += value; }, emitDone() {} } });
+        else await session.start();
+        if (abort.signal.aborted) throw new Error('Connection check timed out');
+        if (testModel && !text.trim()) throw new Error('Model returned no text');
+        return { version: session.version, protocol: 'ready', modelConnected: testModel };
+      } finally { clearTimeout(timer); await session.close(); }
+    },
+    async runTurn(ctx) {
+      if (ctx.attachments?.length) throw new Error('Native scheme C currently accepts text prompts. Use a file path or Netcatty MCP to read an attachment.');
+      if (ctx.toolIntegrationMode !== 'mcp') throw new Error('Native agents require MCP tool integration in Settings > AI > Tools.');
+      let session = sessions.get(ctx.chatSessionId);
+      if (session && (session.engine !== engine || session.key !== fingerprint(ctx))) { await session.close(); session = null; }
+      if (!session) { session = new NativeSession(engine, implementation, ctx); sessions.set(ctx.chatSessionId, session); }
+      return session.run(ctx);
+    },
+    async listModels() { return []; },
+  };
+}
+const nativeSessionManager = {
+  get(chatSessionId, sender) {
+    const session = sessions.get(chatSessionId);
+    return session && (!sender || session.ctx.sender === sender) ? session : undefined;
+  },
+  async closeForChat(chatSessionId) { await sessions.get(chatSessionId)?.stop(); },
+  async closeAll() { await Promise.all([...sessions.values()].map((session) => session.stop())); },
+};
+async function writeSessionFile(session, name, content) {
+  const dir = path.join(session.ctx.getTempDir(), `native-${session.instanceId}`);
+  await fs.mkdir(dir, { recursive: true, mode: 0o700 });
+  const file = path.join(dir, name);
+  await fs.writeFile(file, content, { mode: 0o600 });
+  session.disposers.push(() => fs.rm(file, { force: true }));
+  return file;
+}
+module.exports = { nativeDriver, nativeSessionManager, resourcePath, writeSessionFile, VERSIONS };
diff --git a/electron/bridges/aiBridge/sdk/ompRpcDriver.cjs b/electron/bridges/aiBridge/sdk/ompRpcDriver.cjs
new file mode 100644
index 0000000..d6f20d6
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/ompRpcDriver.cjs
@@ -0,0 +1,72 @@
+"use strict";
+const { nativeDriver } = require('./nativeSessionManager.cjs');
+const { launchPiFamily, handleAgentFrame } = require('./piRpcDriver.cjs');
+
+const implementation = {
+  launch: (session) => launchPiFamily(session, 'omp'),
+  async open(session) {
+    await session.rpc.waitReady();
+    await session.rpc.request('negotiate_protocol', { protocolVersion: 2 });
+    await session.rpc.request('set_ask_dialog', { enabled: true });
+    await session.rpc.request('set_subagent_subscription', { level: 'progress' });
+    // Native OMP host tools forward to the same scoped Netcatty MCP process.
+    const { Client } = require('@modelcontextprotocol/sdk/client/index.js');
+    const { StdioClientTransport } = require('@modelcontextprotocol/sdk/client/stdio.js');
+    const { ToolListChangedNotificationSchema } = require('@modelcontextprotocol/sdk/types.js');
+    session.mcpCalls = new Map();
+    session.hostTools = new Map();
+    const refresh = () => session.rpc.request('set_host_tools', { tools: [...session.hostTools.values()].map((entry) => entry.definition) });
+    for (const server of session.ctx.injectedMcpServers || []) {
+      const client = new Client({ name: 'netcatty-omp-host', version: '1.0.0' });
+      const transport = new StdioClientTransport({ command: server.command, args: server.args, env: { ...session.ctx.env, ...Object.fromEntries(server.env.map(({ name, value }) => [name, value])) }, stderr: 'pipe' });
+      await client.connect(transport);
+      transport.stderr?.resume();
+      session.disposers.push(() => client.close());
+      const update = async () => {
+        const listed = await client.listTools();
+        for (const [name, entry] of session.hostTools) if (entry.client === client) session.hostTools.delete(name);
+        for (const tool of listed.tools) {
+          const name = `netcatty__${tool.name}`;
+          session.hostTools.set(name, { client, toolName: tool.name, definition: {
+            name, description: tool.description || tool.name, parameters: tool.inputSchema, loadMode: 'essential',
+          } });
+        }
+        await refresh();
+      };
+      client.setNotificationHandler(ToolListChangedNotificationSchema, () => update().catch((error) => session.emit('warning', 'mcp-tools', error.message)));
+      await update();
+    }
+    const state = await session.rpc.request('get_state');
+    session.setNativeId(state.sessionFile || state.sessionId);
+  },
+  frame(session, frame) {
+    handleAgentFrame(session, frame);
+    if (frame.type === 'host_tool_call') {
+      const host = session.hostTools.get(frame.toolName);
+      const abort = new AbortController();
+      session.mcpCalls.set(frame.id, abort);
+      void host.client.callTool({ name: host.toolName, arguments: frame.arguments }, undefined, { signal: abort.signal }).then(
+        (result) => { if (!session.closing) session.rpc.send({ type: 'host_tool_result', id: frame.id, result, isError: result.isError }); },
+        (error) => { if (!session.closing) session.rpc.send({ type: 'host_tool_result', id: frame.id, isError: true, result: { content: [{ type: 'text', text: error.message }] } }); },
+      ).finally(() => session.mcpCalls.delete(frame.id));
+    }
+    if (frame.type === 'host_tool_cancel') session.mcpCalls.get(frame.targetId)?.abort();
+    if (frame.type === 'subagent_lifecycle' || frame.type === 'subagent_progress') {
+      const task = frame.payload;
+      const id = task.id || [...session.tasks.values()].find((entry) => entry.index === task.index)?.id;
+      if (id) session.tasks.set(id, { ...session.tasks.get(id), ...task, name: task.agent, id, kind: 'subagent' });
+      session.publish();
+    }
+    if (frame.type === 'prompt_result') {
+      if (frame.status === 'error') session.turnError = new Error(frame.error?.message || 'OMP prompt failed');
+      if (frame.agentInvoked === false) { session.finish(session.turnError); session.turnError = null; }
+    }
+    if (frame.type === 'session_settled') { session.finish(session.turnError); session.turnError = null; }
+    if (frame.type === 'rpc_frame_error' || frame.type === 'fatal') session.finish(new Error(frame.error || 'OMP frame overflow'));
+  },
+  async prompt(session, message) {
+    const result = await session.rpc.request('prompt', { message });
+    if (result?.agentInvoked === false) session.finish();
+  },
+};
+module.exports = nativeDriver('omp', implementation);
