+"use strict";
+// Seed/verify only synthetic records in an isolated acceptance profile.
+const assert = require('node:assert/strict');
+const { connect } = require('./native-agents.electron.live.cjs');
+(async () => {
+  const cdp = await connect();
+  try {
+    if (process.argv[2] === 'seed') {
+      await cdp.evaluate(`(async()=>{
+        const encrypted=await window.netcatty.credentialsEncrypt('synthetic-acceptance-secret');
+        localStorage.setItem('netcatty_hosts_v1',JSON.stringify([{id:'c1-retained-host',label:'Retained host',hostname:'192.0.2.1',username:'acceptance',port:22,tags:[],os:'linux',password:encrypted}]));
+        localStorage.setItem('netcatty_keys_v1',JSON.stringify([{id:'c1-retained-key',label:'Retained key',type:'ED25519',privateKey:encrypted,source:'generated',category:'key',created:1}]));
+        localStorage.setItem('netcatty_ai_sessions_v1',JSON.stringify([{id:'c1-retained-chat',title:'Retained chat',agentId:'catty',scope:{type:'global'},messages:[],createdAt:1,updatedAt:1}]));
+        localStorage.setItem('netcatty_ai_external_agents_v1',JSON.stringify([{id:'retained-codex',name:'Existing Codex',sdkBackend:'codex',enabled:true,command:'existing-codex.cmd',apiKey:encrypted}]));
+        localStorage.setItem('netcatty_c1_acceptance_cipher',encrypted);
+        localStorage.setItem('netcatty_term_font_size_v1','15');
+        return true;
+      })()`);
+      console.log('Original 1.1.83: synthetic host/key/chat/Codex/settings seeded through existing profile and safeStorage.');
+    } else if (process.argv[2] === 'verify') {
+      const result = await cdp.evaluate(`(async()=>({
+        host:JSON.parse(localStorage.getItem('netcatty_hosts_v1')).some(x=>x.id==='c1-retained-host'),
+        key:JSON.parse(localStorage.getItem('netcatty_keys_v1')).some(x=>x.id==='c1-retained-key'),
+        chat:JSON.parse(localStorage.getItem('netcatty_ai_sessions_v1')).some(x=>x.id==='c1-retained-chat'),
+        codex:JSON.parse(localStorage.getItem('netcatty_ai_external_agents_v1')).some(x=>x.id==='retained-codex'),
+        setting:localStorage.getItem('netcatty_term_font_size_v1')==='15',
+        credential:(await window.netcatty.credentialsDecrypt(localStorage.getItem('netcatty_c1_acceptance_cipher')))==='synthetic-acceptance-secret',
+        dpapi:localStorage.getItem('netcatty_c1_acceptance_cipher').startsWith('enc:v1:')
+      }))()`);
+      assert(Object.values(result).every(Boolean), JSON.stringify(result));
+      console.log(JSON.stringify({ retainedOriginalProfile: result }));
+    } else if (process.argv[2] === 'quit') {
+      await cdp.evaluate(`(()=>{setTimeout(()=>window.netcatty.quitApp(),100);return true;})()`);
+    }
+  } finally { cdp.close(); }
+})().catch(error => { console.error(error); process.exitCode = 1; });
