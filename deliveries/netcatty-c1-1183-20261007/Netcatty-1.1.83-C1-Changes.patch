@@ -0,0 +1,19 @@
+"use strict";
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { nativeEntry } = require('./nativeCli.cjs');
+
+test('Windows Pi installer and npm command launchers keep their original entry', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'netcatty-native-cli-'));
+  try {
+    for (const relative of ['.pi/agent/bin/pi.cmd', 'npm/dsh.cmd']) {
+      const shim = path.join(root, relative);
+      fs.mkdirSync(path.dirname(shim), { recursive: true });
+      fs.writeFileSync(shim, '@echo off\r\n');
+      assert.equal(nativeEntry(shim), shim);
+    }
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
