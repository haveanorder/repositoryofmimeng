+"use strict";
+// Operates only on a deliberately isolated Electron test profile.
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const os = require('node:os');
+const assert = require('node:assert/strict');
+const { connect } = require('./native-agents.electron.live.cjs');
+const { createNativeModelService } = require('./native-model-service.cjs');
+async function wait(cdp, expression, description, timeout = 60000) {
+  const end = Date.now() + timeout;
+  do { const value = await cdp.evaluate(`(()=>{const v=(${expression});return typeof v==='object'?Boolean(v):v;})()`); if (value) return value; await new Promise(r => setTimeout(r, 250)); } while (Date.now() < end);
+  throw new Error(`Timed out: ${description}; ${await cdp.evaluate('document.body.innerText')}`);
+}
+async function main() {
+  const root = process.env.NETCATTY_NATIVE_RUNTIME;
+  const entries = JSON.parse(await fs.readFile(path.join(root, 'engines.json'), 'utf8'));
+  const scratch = await fs.mkdtemp(path.join(root, 'ui-smoke-'));
+  const service = await createNativeModelService();
+  const main = await connect();
+  let settings;
+  try {
+    await main.evaluate('window.netcatty.openSettingsWindow()');
+    for (let i = 0; i < 40; i++) { try { settings = await connect('#/settings'); break; } catch { await new Promise(r => setTimeout(r, 250)); } }
+    assert(settings);
+    await wait(settings, `document.querySelector('[role="tab"]')`, 'settings mounted');
+    for (const tab of ['AI', 'Agents']) {
+      await settings.evaluate(`(()=>{const b=[...document.querySelectorAll('[role="tab"]')].find(e=>e.innerText===${JSON.stringify(tab)}); b.dispatchEvent(new MouseEvent('mousedown',{bubbles:true,button:0}));})()`);
+      await new Promise(r => setTimeout(r, 400));
+    }
+    await wait(settings, 'document.querySelectorAll("[data-native-settings]").length===3', 'three settings cards');
+    for (const engine of ['omp', 'pi', 'dsh']) {
+      const dir = path.join(scratch, engine); await fs.mkdir(dir);
+      const models = { providers: { local: { api: 'openai-completions', baseUrl: `${service.url}/v1`, apiKey: 'local-test-key', models: [{ id: 'netcatty-smoke', reasoning: false, input: ['text'], contextWindow: 64000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }] } } };
+      await fs.writeFile(path.join(dir, 'models.json'), JSON.stringify(models));
+      await fs.writeFile(path.join(dir, 'models.yml'), JSON.stringify(models));
+      const env = { PI_CONFIG_DIR: path.relative(os.homedir(), path.join(dir, 'omp-config')), PI_CODING_AGENT_DIR: dir, DSH_HOME: path.join(dir, 'dsh'), DSH_TELEMETRY_DISABLED: '1', DEEPSEEK_BASE_URL: service.url };
+      const config = { engine, command: entries[engine], cwd: scratch, model: engine === 'dsh' ? 'deepseek-official/deepseek-flash' : 'local/netcatty-smoke', env };
+      await settings.evaluate(`(c=>{const card=document.querySelector('[data-native-settings="'+c.engine+'"]'); card.querySelector('details').open=true;
+        const set=(e,v)=>{Object.getOwnPropertyDescriptor(e.tagName==='TEXTAREA'?HTMLTextAreaElement.prototype:HTMLInputElement.prototype,'value').set.call(e,v);e.dispatchEvent(new Event('input',{bubbles:true}));};
+        const fields=[...card.querySelectorAll('input')].filter(e=>e.type==='text'); set(fields[0],c.command);set(fields[1],c.cwd);set(fields[2],c.model);
+        set(card.querySelector('textarea'),JSON.stringify(c.env)); set(fields[c.engine==='dsh'?5:4],'DEEPSEEK_API_KEY'); set(card.querySelector('input[type="password"]'),'local-test-key');
+      })(${JSON.stringify(config)})`);
+      await settings.evaluate(`document.querySelector('[data-native-settings="${engine}"]').querySelectorAll('button')[1].click()`);
+      const result = await wait(settings, `(()=>{const c=document.querySelector('[data-native-settings="${engine}"]');return c.querySelector('[role="alert"],[role="status"]')?.innerText;})()`, `${engine} settings model connection`);
+      assert.match(result, /model replied successfully|模型.*回复/i);
+      console.log(JSON.stringify({ engine, actualSettingsModelCheck: result }));
+    }
+    const saved = await settings.evaluate(`JSON.parse(localStorage.getItem('netcatty_ai_external_agents_v1')).filter(a=>['omp','pi','dsh'].includes(a.sdkBackend)).map(a=>({engine:a.sdkBackend,version:a.cliVersion,keyPresent:!!a.apiKey,encryptedKey:a.apiKey?.startsWith('enc:v1:')}))`);
+    assert.equal(saved.length, 3); assert(saved.every(a => a.keyPresent));
+    if (process.platform === 'win32') assert(saved.every(a => a.encryptedKey), 'Windows keys must use existing DPAPI safeStorage');
+    console.log(JSON.stringify({ settingsSaved: saved }));
+    await main.evaluate(`(()=>{const b=document.querySelector('button[aria-label="Local shell"]');b?.click();})()`);
+    await wait(main, 'document.querySelector("button svg.lucide-sparkles")', 'terminal AI entry');
+    await main.evaluate(`document.querySelector('button svg.lucide-sparkles').closest('button').click()`);
+    await wait(main, `document.querySelector('textarea[placeholder*="Ask"]') || document.querySelector('textarea[placeholder*="Message"]')`, 'chat composer');
+    for (const [engine, name] of [['omp','Oh My Pi'],['pi','Pi'],['dsh','DeepSeek Harness']]) {
+      await main.evaluate(`(()=>{const panel=document.querySelector('[data-section="terminal-side-panel-content"]'); const b=[...panel.querySelectorAll('button')].find(x=>x.querySelector('svg.lucide-chevron-down')&&x.innerText);b.click();})()`);
+      await wait(main, `[...document.querySelectorAll('button')].some(b=>b.innerText.startsWith(${JSON.stringify(name)}+String.fromCharCode(10))&&b.offsetWidth)`, `${engine} agent menu`);
+      await main.evaluate(`(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.innerText.startsWith(${JSON.stringify(name)}+String.fromCharCode(10))&&b.offsetWidth);b.click();})()`);
+      await new Promise(r => setTimeout(r, 350));
+      const before = service.requests.length;
+      await main.evaluate(`(()=>{const e=[...document.querySelectorAll('textarea')].find(x=>x.offsetWidth&&!x.classList.contains('xterm-helper-textarea')); Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(e,'NC_ECHO ${engine} actual sidebar');e.dispatchEvent(new Event('input',{bubbles:true}));})()`);
+      await main.evaluate(`(()=>{const e=[...document.querySelectorAll('textarea')].find(x=>x.value==='NC_ECHO ${engine} actual sidebar'); e.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',bubbles:true}));})()`);
+      await wait(main, `document.querySelector('[data-native-engine="${engine}"]')?.innerText.includes('Ready')&&document.body.innerText.includes('LOCAL_MODEL_OK')`, `${engine} actual sidebar response`);
+      assert(service.requests.length > before, `${engine}: no real model request from sidebar`);
+      console.log(JSON.stringify({ engine, agentSelectedInSidebar: true, realCliResponseInSidebar: true }));
+    }
+    const screenshot = await main.request('Page.captureScreenshot', { format: 'png' });
+    await fs.writeFile(path.join(scratch, 'sidebar.png'), Buffer.from(screenshot.data, 'base64'));
+    console.log(`Actual packaged settings + saved config + sidebar AgentRuntime; LOCAL controlled model only. ${scratch}`);
+  } finally { settings?.close(); main.close(); await service.close(); }
+}
+if (require.main === module) main().catch(error => { console.error(error); process.exitCode = 1; });
+module.exports = { wait };
diff --git a/scripts/native-model-service.cjs b/scripts/native-model-service.cjs
new file mode 100644
index 0000000..eb0eed9
--- /dev/null
+++ b/scripts/native-model-service.cjs
@@ -0,0 +1,62 @@
+"use strict";
+// A deterministic LOCAL test service, not a cloud model. Real CLIs call it over HTTP.
+const http = require('node:http');
+const { randomUUID } = require('node:crypto');
+
+async function createNativeModelService(onRequest = () => {}, port = 0) {
+  const requests = [];
+  const server = http.createServer(async (req, res) => {
+    if (req.method === 'GET') { res.setHeader('content-type', 'application/json'); res.end(JSON.stringify({ data: [{ id: 'netcatty-smoke', object: 'model' }] })); return; }
+    let raw = '';
+    for await (const chunk of req) raw += chunk;
+    const body = JSON.parse(raw);
+    requests.push(body); onRequest(body);
+    const messages = body.messages || [];
+    const index = messages.findLastIndex((message) => message.role === 'user' && /NC_(ECHO|TOOL|HOLD|REMOTE|EXEC|QUESTION|PLAN|JOB|TASK)/.test(JSON.stringify(message.content)));
+    const content = JSON.stringify(messages[index]?.content || '');
+    // Anthropic adapters merge consecutive user messages after an interrupted
+    // turn. Act on the latest test instruction, not an earlier NC_HOLD block.
+    const marker = [...content.matchAll(/NC_(ECHO|TOOL|HOLD|REMOTE|EXEC|QUESTION|PLAN|JOB|TASK)/g)].at(-1);
+    const prompt = content.slice(marker?.index || 0);
+    if (prompt.includes('NC_HOLD')) { res.writeHead(200, { 'content-type': 'text/event-stream' }); res.write(': waiting for cancellation\n\n'); return; }
+    const usedTool = messages.slice(index + 1).some((message) => message.role === 'tool' || JSON.stringify(message.content).includes('tool_result'));
+    const tools = (body.tools || []).map((tool) => tool.function || tool);
+    const tool = !usedTool && prompt.includes('NC_QUESTION') ? tools.find((item) => item.name === 'ask_user_question')
+      : !usedTool && prompt.includes('NC_PLAN') ? tools.find((item) => item.name === 'exit_plan_mode')
+      : !usedTool && prompt.includes('NC_JOB') ? tools.find((item) => item.name === 'bash')
+      : !usedTool && prompt.includes('NC_TASK') ? tools.find((item) => item.name === 'task')
+      : !usedTool && prompt.includes('NC_EXEC')
+      ? tools.find((item) => /terminal_execute$/.test(item.name))
+      : !usedTool && prompt.includes('NC_REMOTE')
+      ? tools.find((item) => /get_environment$/.test(item.name))
+      : !usedTool && prompt.includes('NC_TOOL') ? tools.find((item) => item.name === 'bash') : null;
+    const args = prompt.includes('NC_QUESTION') ? { questions: [{ id: 'choice', question: 'Choose a test option', options: [{ label: 'Alpha' }, { label: 'Beta' }] }], timeout: prompt.includes('deferred') ? 1 : -1 }
+      : prompt.includes('NC_PLAN') ? { plan: '# Native integration plan\n\n1. Inspect the selected terminal.\n2. Report the result.' }
+      : prompt.includes('NC_JOB') ? { command: 'printf NATIVE_JOB_STARTED; sleep 30', run_in_background: true }
+      : prompt.includes('NC_TASK') ? { agent: 'task', task: 'NC_HOLD child task', solutionSpace: 'Only respond to this text; use no tools.', tools: [], model: body.model }
+      : prompt.includes('NC_EXEC') ? { sessionId: 'native-smoke-a', command: 'echo NETCATTY_MCP_CLI_OK' }
+      : prompt.includes('NC_REMOTE') ? {} : { command: 'printf NATIVE_LOCAL_OK' };
+    if (tool && (tool.input_schema?.required || tool.parameters?.required || []).includes('description')) args.description = 'Print a local integration marker';
+    const text = `LOCAL_MODEL_OK \u4e2d\u6587 ${usedTool ? 'tool returned' : 'echo'}`;
+    const id = randomUUID();
+    res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache' });
+    if (req.url.includes('/messages')) {
+      const send = (type, data) => res.write(`event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`);
+      send('message_start', { message: { id, type: 'message', role: 'assistant', model: body.model, content: [], stop_reason: null, usage: { input_tokens: 12, output_tokens: 0 } } });
+      send('content_block_start', { index: 0, content_block: tool ? { type: 'tool_use', id, name: tool.name, input: {} } : { type: 'text', text: '' } });
+      send('content_block_delta', { index: 0, delta: tool ? { type: 'input_json_delta', partial_json: JSON.stringify(args) } : { type: 'text_delta', text } });
+      send('content_block_stop', { index: 0 });
+      send('message_delta', { delta: { stop_reason: tool ? 'tool_use' : 'end_turn', stop_sequence: null }, usage: { output_tokens: 8 } });
+      send('message_stop', {});
+    } else {
+      const send = (delta, finish_reason = null) => res.write(`data: ${JSON.stringify({ id, object: 'chat.completion.chunk', created: 1, model: body.model, choices: [{ index: 0, delta, finish_reason }], usage: { prompt_tokens: 12, completion_tokens: 8, total_tokens: 20 } })}\n\n`);
+      send(tool ? { role: 'assistant', tool_calls: [{ index: 0, id, type: 'function', function: { name: tool.name, arguments: JSON.stringify(args) } }] } : { role: 'assistant', content: text });
+      send({}, tool ? 'tool_calls' : 'stop');
+      res.write('data: [DONE]\n\n');
+    }
+    res.end();
+  });
+  await new Promise((resolve) => server.listen(port, '127.0.0.1', resolve));
+  return { url: `http://127.0.0.1:${server.address().port}`, requests, close: () => { server.closeAllConnections(); return new Promise((resolve) => server.close(resolve)); } };
+}
+module.exports = { createNativeModelService };
