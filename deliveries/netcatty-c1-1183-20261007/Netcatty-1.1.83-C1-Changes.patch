index 0000000..a03c8a3
--- /dev/null
+++ b/electron/bridges/aiBridge/sdk/dshNativeDriver.cjs
@@ -0,0 +1,70 @@
+"use strict";
+const { nativeDriver, resourcePath, writeSessionFile } = require('./nativeSessionManager.cjs');
+
+const implementation = {
+  async launch(session) {
+    const { ctx } = session;
+    const patch = [
+      { id: 'sdk-jsonrpc-server', disabled: true },
+      { insert: [{ id: 'netcatty-questions', name: '@deepseek-ai/dsh-tool-ask-user', config: { mode: 'timed' } }] },
+      { insert: [{ id: 'netcatty-bridge', name: resourcePath('../../../..', 'packages/netcatty-dsh-bridge/bridge.mjs') }] },
+    ];
+    for (const server of ctx.injectedMcpServers || []) patch.push({ insert: [{ id: 'netcatty-mcp', name: '@deepseek-ai/dsh-mcp-client', config: {
+      transport: 'stdio', serverName: 'netcatty', command: server.command, args: server.args,
+      env: Object.fromEntries(server.env.map(({ name, value }) => [name, value])), failOnStartupError: true, toolCallTimeoutMs: 300000,
+    } }] });
+    const patchPath = await writeSessionFile(session, 'dsh.patch.json', JSON.stringify(patch));
+    const args = [...JSON.parse(ctx.env.NETCATTY_NATIVE_ARGS || '[]'), '--profile', ctx.env.NETCATTY_DSH_PROFILE || 'sdk', '--patch', patchPath];
+    return { args, env: { ...ctx.env, NETCATTY_DSH_ENTRY: session.entry, NETCATTY_DSH_VERSION: session.version,
+      NETCATTY_NATIVE_LOCAL_TOOLS: ctx.env.NETCATTY_NATIVE_LOCAL_TOOLS || 'disabled', NETCATTY_NATIVE_PERMISSION: ctx.permissionMode,
+    } };
+  },
+  async open(session) {
+    await session.rpc.waitReady();
+    const model = session.ctx.model;
+    const separator = model?.indexOf('/') ?? -1;
+    const result = await session.rpc.request('initialize', {
+      cwd: session.ctx.cwd, resumeSessionId: session.resume,
+      ...(model ? { provider: separator < 0 ? undefined : model.slice(0, separator), model: separator < 0 ? model : model.slice(separator + 1) } : {}),
+    });
+    session.setNativeId(result.sessionId);
+    const snapshot = await session.rpc.request('snapshot');
+    session.plan = snapshot.plan;
+    for (const job of snapshot.jobs) session.tasks.set(job.id, { ...job, title: job.label, kind: 'job' });
+  },
+  frame(session, frame) {
+    if (frame.type === 'plan-state') { session.plan = frame.plan; session.publish(); }
+    if (frame.type === 'assistant-stream') {
+      const chunk = frame.frame.chunk;
+      if (chunk?.type === 'text-delta') session.emit('text', chunk.text);
+      if (chunk?.type === 'reasoning-delta') session.emit('reasoning', chunk.text);
+      if (chunk?.type === 'usage') session.emit('usage', { inputTokens: chunk.usage.inputTokens, outputTokens: chunk.usage.outputTokens });
+    }
+    if (frame.type === 'session-event') {
+      const event = frame.event;
+      if (event.type === 'tool/call') session.emit('toolCall', event.data.name, JSON.parse(event.data.arguments), event.data.callId);
+      if (event.type === 'tool/result') session.emit('toolResult', event.data.message.source.callId, event.data.message.content);
+      if (event.type === 'turn/end' && event.data.reason.kind === 'error') session.turnError = new Error(JSON.stringify(event.data.reason));
+      if (event.type === 'todo/write') {
+        const items = event.data.todos.map((todo) => ({ text: todo.content, completed: todo.status === 'completed' }));
+        session.emit('planUpdate', 'dsh-todos', items, items.every((item) => item.completed) ? 'completed' : 'running');
+      }
+    }
+    if (frame.type === 'job-event' && frame.event.job) {
+      const job = frame.event.job;
+      session.tasks.set(job.id, { ...job, title: job.label, kind: 'job' }); session.publish();
+    }
+    if (frame.type === 'agent-status' && frame.primary && !session.turn && !session.closing) {
+      session.status = frame.status; session.publish();
+    }
+    if (frame.type === 'turn-settled') {
+      if (session.turn && frame.turnId !== session.turn.id) return;
+      if (session.turn) session.finish(session.turnError);
+      else if (!session.closing) { session.status = session.turnError ? 'error' : 'idle'; session.publish(); }
+      session.turnError = null;
+    }
+    if (frame.type === 'fatal') session.finish(new Error(frame.error));
+  },
+  async prompt(session, message) { await session.rpc.request('prompt', { message, turnId: session.turn.id }); },
+};
+module.exports = nativeDriver('dsh', implementation);
